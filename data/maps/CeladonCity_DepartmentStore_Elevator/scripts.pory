}

script CeladonCity_DepartmentStore_Elevator_EventScript_ExitFloorSelect {
    special(CloseElevatorCurrentFloorWindow)
    releaseall
    end
}

script CeladonCity_DepartmentStore_Elevator_EventScript_MoveElevator {
    special(CloseElevatorCurrentFloorWindow)
    closemessage
    waitse
    special(AnimateElevator)
    waitstate
    setflag(FLAG_TEMP_2)
    return
}
