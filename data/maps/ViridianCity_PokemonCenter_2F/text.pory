// Welcome scene (first visit)
text ViridianCity_PokemonCenter_2F_Text_WelcomeCallOver {
    "{COLOR RED}Hey there, Trainer! Could you\n"
    "come over here for a moment?"
}

text ViridianCity_PokemonCenter_2F_Text_Welcome {
    "{COLOR RED}Welcome to the Pokémon Service\n"
    "Corner!\p"
    "I'm here to help you get the\n"
    "most out of your Pokémon!\p"
    "I can help your Pokémon remember\n"
    "forgotten moves or even change\l"
    "their Abilities!\p"
    "The young lady to my right offers\n"
    "a rather special service of her\l"
    "own.\p"
    "Her Pokémon Booster allows\n"
    "experienced Trainers to fine-tune\l"
    "their Pokémon's individual stats\l"
    "and reach their full potential!\p"
    "It's a service for those who've\n"
    "truly mastered the art of\l"
    "Pokémon training.\p"
    "So, keep growing together! You\n"
    "might find yourself ready for it\l"
    "someday!"
}

// Object 1 - Move Relearner & Ability Changer
text ViridianCity_PokemonCenter_2F_Text_Obj1Greeting {
    "{COLOR RED}Oh, happy to see you, Trainer!\p"
    "I can help your Pokémon remember\n"
    "forgotten moves or awaken their\l"
    "other Abilities!\p"
    "There's always something new to\n"
    "discover about your Pokémon!\p"
    "So, what can I do for you\n"
    "this time?"
}

text ViridianCity_PokemonCenter_2F_Text_Obj1WhichMon {
    "{COLOR RED}Which Pokémon should I help?"
}

text ViridianCity_PokemonCenter_2F_Text_Obj1TeachWhichMove {
    "{COLOR RED}Which move should it remember?"
}

text ViridianCity_PokemonCenter_2F_Text_Obj1NoMoves {
    "{COLOR RED}Hmm, it doesn't seem to have\n"
    "any forgotten moves…"
}

text ViridianCity_PokemonCenter_2F_Text_Obj1CantEgg {
    "{COLOR RED}Oh, that's an EGG!\n"
    "I can't help with that, sorry!"
}

text ViridianCity_PokemonCenter_2F_Text_Obj1CurrentAbility {
    "{COLOR RED}Your Pokémon's current Ability\n"
    "is {STR_VAR_1}.\p"
    "Would you like me to change it?"
}

text ViridianCity_PokemonCenter_2F_Text_Obj1AbilityChanged {
    "{COLOR RED}There we go!\p"
    "Your Pokémon's Ability has been\n"
    "changed to {STR_VAR_1}!"
}

text ViridianCity_PokemonCenter_2F_Text_Obj1OnlyOneAbility {
    "{COLOR RED}Hmm, it seems your Pokémon\n"
    "only has one possible Ability.\p"
    "There's nothing to change here!"
}

text ViridianCity_PokemonCenter_2F_Text_Obj1Bye {
    "{COLOR RED}Come back anytime you need\n"
    "my help!"
}

// Object 2 - Pokémon Booster (Stat Editor)
text ViridianCity_PokemonCenter_2F_Text_Obj2PreLeague {
    "{COLOR RED}Oh, hello there!\p"
    "I offer a special service known\n"
    "as the Pokémon Booster!\p"
    "However, this service is only\n"
    "available to Trainers who have\l"
    "proven their strength by\l"
    "conquering the Pokémon League.\p"
    "Come back when you've earned\n"
    "that honor!"
}

text ViridianCity_PokemonCenter_2F_Text_Obj2PostLeague {
    "{COLOR RED}Well, well! Look who's back!\p"
    "My, you've certainly come a long\n"
    "way! I can tell you've become a\l"
    "much more experienced Trainer!\p"
    "That means you're finally ready\n"
    "to use the Pokémon Booster!\p"
    "With this special service, you can\n"
    "fine-tune your Pokémon's\l"
    "individual stats and help them\l"
    "reach their full potential.\p"
    "I'm so excited to see what you'll\n"
    "accomplish with your team!\p"
    "So, shall we give your Pokémon\n"
    "a little boost?"
}
