text Route16_NorthEntrance_2F_Text_OnBikeRideWithGirlfriend {
    "I'm on a relaxing ride on my new\n"
    "bike with my girlfriend.$"
}

text Route16_NorthEntrance_2F_Text_RidingTogetherOnNewBikes {
    "We're going riding together on our\n"
    "new bikes.$"
}

text Route16_NorthEntrance_2F_Text_ItsCeladonDeptStore {
    "Let's see what the binoculars have\n"
    "to show…\p"
    "It's the Celadon Dept. Store!$"
}

text Route16_NorthEntrance_2F_Text_LongPathOverWater {
    "Let's see what the binoculars have\n"
    "to show…\p"
    "There's a long path over water far\n"
    "away.$"
}

text Route16_NorthEntrance_2F_Text_GiveAmuletCoinIfCaught40 {
    "Hi! Remember me?\n"
    "I'm one of Prof. Oak's Aides.\p"
    "If your Pokédex has complete data\n"
    "on 40 species, I'm supposed to\l"
    "give you a reward.\p"
    "Prof. Oak entrusted me with an\n"
    "Amulet Coin for you.\p"
    "So, {PLAYER}, let me ask you.\p"
    "Have you gathered data on at least\n"
    "40 kinds of Pokémon?$"
}

text Route16_NorthEntrance_2F_Text_GreatHereYouGo {
    "Great! You have caught or owned\n"
    "{STR_VAR_3} kinds of Pokémon!\p"
    "Congratulations!\n"
    "Here you go!$"
}

text Route16_NorthEntrance_2F_Text_ReceivedAmuletCoinFromAide {
    "{PLAYER} received the Amulet Coin\n"
    "from the Aide.$"
}

text Route16_NorthEntrance_2F_Text_ExplainAmuletCoin {
    "An Amulet Coin is an item to be\n"
    "held by a Pokémon.\p"
    "If the Pokémon appears in a winning\n"
    "battle, you will earn more money.$"
}
