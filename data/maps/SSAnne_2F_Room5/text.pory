text SSAnne_2F_Room5_Text_HaveYouGoneToSafariZone {
    "Have you gone to the Safari Zone\n"
    "in Fuchsia City?\p"
    "There are many kinds of rare\n"
    "Pokémon.$"
}

text SSAnne_2F_Room5_Text_WeThinkSafariZoneIsAwesome {
    "Me and my daddy think the Safari\n"
    "Zone is awesome!\l"
    "I wish we could go there again.$"
}
