text CeladonCity_Gym_Text_ErikaIntro {
    "Hello…\n"
    "Lovely weather, isn't it?\l"
    "It's so pleasant…\p"
    "…Oh, dear…\n"
    "I must have dozed off. Welcome.\p"
    "My name is Erika.\n"
    "I am the Leader of Celadon Gym.\p"
    "I am a student of the art of\n"
    "flower arranging.\p"
    "My Pokémon are solely of the\n"
    "Grass type.\p"
    "…Oh, I'm sorry, I had no idea that\n"
    "you wished to challenge me.\p"
    "Very well, but I shall not lose.{PLAY_BGM MUS_ENCOUNTER_GYM_LEADER}$"
}

text CeladonCity_Gym_Text_ErikaDefeat {
    "Oh!\n"
    "I concede defeat.\l"
    "You are remarkably strong.\p"
    "I must confer on you the\n"
    "Rainbowbadge.$"
}

text CeladonCity_Gym_Text_ErikaPostBattle {
    "You are cataloging Pokémon?\n"
    "I must say I'm impressed.\p"
    "I would never collect Pokémon if\n"
    "they were unattractive.$"
}

text CeladonCity_Gym_Text_ExplainRainbowBadgeTakeThis {
    "The Rainbowbadge will make\n"
    "Pokémon up to Lv. 50 obey.\p"
    "It also allows Pokémon to use\n"
    "Strength in and out of battle.\p"
    "Please also take this with you.$"
}

text CeladonCity_Gym_Text_ReceivedTM19FromErika {
    "{PLAYER} received TM19\n"
    "from Erika.$"
}

text CeladonCity_Gym_Text_ExplainTM19 {
    "TM19 contains Giga Drain.\p"
    "Half the damage it inflicts is\n"
    "drained to heal your Pokémon.\p"
    "Wouldn't you agree that it's a\n"
    "wonderful move?$"
}

text CeladonCity_Gym_Text_ShouldMakeRoomForThis {
    "You should make room for this.$"
}

text CeladonCity_Gym_Text_KayIntro {
    "I should tell you about this Gym.\p"
    "Only real ladies are allowed in\n"
    "here!$"
}

text CeladonCity_Gym_Text_KayDefeat {
    "You're too rough!$"
}

text CeladonCity_Gym_Text_KayPostBattle {
    "Bleaah!\n"
    "I hope Erika wipes you out!$"
}

text CeladonCity_Gym_Text_BridgetIntro {
    "Oh, welcome.\n"
    "I was getting bored.$"
}

text CeladonCity_Gym_Text_BridgetDefeat {
    "My makeup!$"
}

text CeladonCity_Gym_Text_BridgetPostBattle {
    "Grass-type Pokémon are tough\n"
    "against the Water type.\p"
    "They also have an edge on Rock-\n"
    "and Ground-type Pokémon.$"
}

text CeladonCity_Gym_Text_TinaIntro {
    "…Weren't you peeking in here\n"
    "earlier?$"
}

text CeladonCity_Gym_Text_TinaDefeat {
    "You're an eye-opener!$"
}

text CeladonCity_Gym_Text_TinaPostBattle {
    "Oh, you were looking at Erika…\n"
    "You weren't looking at me…$"
}

text CeladonCity_Gym_Text_TamiaIntro {
    "Look, look!\n"
    "See my Pokémon!\p"
    "I like the Grass type.\n"
    "I like how they're easy to raise.$"
}

text CeladonCity_Gym_Text_TamiaDefeat {
    "No!$"
}

text CeladonCity_Gym_Text_TamiaPostBattle {
    "We only use Grass-type Pokémon at\n"
    "our Gym.\p"
    "Why? We also use them for making\n"
    "flower arrangements!$"
}

text CeladonCity_Gym_Text_LisaIntro {
    "Oh, hey!\p"
    "We don't like Bug- or Fire-type\n"
    "Pokémon in here!$"
}

text CeladonCity_Gym_Text_LisaDefeat {
    "Oh!\n"
    "You!$"
}

text CeladonCity_Gym_Text_LisaPostBattle {
    "Our Leader Erika might be quiet,\n"
    "but she's famous around here.$"
}

text CeladonCity_Gym_Text_LoriIntro {
    "Pleased to meet you.\n"
    "My hobby is Pokémon training.$"
}

text CeladonCity_Gym_Text_LoriDefeat {
    "Oh!\n"
    "Splendid!$"
}

text CeladonCity_Gym_Text_LoriPostBattle {
    "I have a blind date coming up.\n"
    "I have to learn to be polite,\l"
    "especially if I have to battle.$"
}

text CeladonCity_Gym_Text_MaryIntro {
    "Welcome to Celadon Gym!\p"
    "You'd better not underestimate\n"
    "the nice ladies here.$"
}

text CeladonCity_Gym_Text_MaryDefeat {
    "Oh!\n"
    "Beaten!$"
}

text CeladonCity_Gym_Text_MaryPostBattle {
    "I didn't bring my best Pokémon.\n"
    "Wait until next time!$"
}

text CeladonCity_Gym_Text_GymStatue {
    "Celadon Pokémon Gym\n"
    "Leader: Erika\p"
    "Winning Trainers:\n"
    "{RIVAL}$"
}

text CeladonCity_Gym_Text_GymStatuePlayerWon {
    "Celadon Pokémon Gym\n"
    "Leader: Erika\p"
    "Winning Trainers:\n"
    "{RIVAL}, {PLAYER}$"
}
