text SaffronCity_House_Text_DontLookAtMyLetter {
    "…Thank you for writing.\n"
    "I hope to see you soon!\p"
    "…Hey!\n"
    "Don't look at my letter!$"
}

text SaffronCity_House_Text_Pidgey {
    "Pidgey: Kurukkoo!$"
}

text SaffronCity_House_Text_GettingCopycatPokeDoll {
    "The Copycat is cute!\n"
    "I'm getting her a Poké Doll.$"
}

text SaffronCity_House_Text_ExplainPPUp {
    "I was given a PP Up as a gift.\p"
    "It's used to increase the PP of\n"
    "a Pokémon's move.\p"
    "I should use it on a powerful move\n"
    "with only a few PP.$"
}
