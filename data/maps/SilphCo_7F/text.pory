text SilphCo_7F_Text_HaveMonForSavingUs {
    "Oh! Hi! You're not a Rocket!\n"
    "You came to save us?\l"
    "Why, thank you!\p"
    "I want you to have this Pokémon\n"
    "for saving us.$"
}

text SilphCo_7F_Text_ObtainedLaprasFromEmployee {
    "{PLAYER} obtained a Lapras from\n"
    "the Silph employee!$"
}

text SilphCo_7F_Text_ExplainLapras {
    "It's a Lapras.\n"
    "It's a very intelligent Pokémon.\p"
    "We kept it in our lab, but it will\n"
    "be much better off with you.\p"
    "I think you will be a good Trainer\n"
    "for Lapras!\p"
    "It's a good swimmer.\n"
    "It'll give you a lift across water!$"
}

text SilphCo_7F_Text_RocketBossWentToBoardroom {
    "Team Rocket's Boss went to the\n"
    "boardroom!\p"
    "Is our President okay?\n"
    "I'm worried.$"
}

text SilphCo_7F_Text_OhNo {
    "あ‥　もう　もてないぞ$"
}

text SilphCo_7F_Text_SavedAtLast {
    "たすかったよ　ありがと！$"
}

text SilphCo_7F_Text_RocketsAfterMasterBall {
    "Team Rocket was after the Master\n"
    "Ball, which catches any Pokémon.$"
}

text SilphCo_7F_Text_CanceledMasterBallProject {
    "We canceled the Master Ball\n"
    "project because of Team Rocket.$"
}

text SilphCo_7F_Text_BadIfTeamRocketTookOver {
    "It would be bad if Team Rocket\n"
    "took over Silph or our Pokémon.$"
}

text SilphCo_7F_Text_WowYouChasedOffTeamRocket {
    "Wow!\p"
    "You chased off Team Rocket all by\n"
    "yourself?$"
}

text SilphCo_7F_Text_ReallyDangerousHere {
    "You!\n"
    "It's really dangerous here!\p"
    "You came to save me?\n"
    "You can't!$"
}

text SilphCo_7F_Text_ThankYouSoMuch {
    "Thank you so much!$"
}

text SilphCo_7F_Text_Grunt3Intro {
    "Uh-oh!\n"
    "I smell a little mouse!$"
}

text SilphCo_7F_Text_Grunt3Defeat {
    "Lights out!$"
}

text SilphCo_7F_Text_Grunt3PostBattle {
    "You won't find my Boss by just\n"
    "scurrying around!$"
}

text SilphCo_7F_Text_JoshuaIntro {
    "Heheh!\p"
    "You mistook me for a Silph worker?$"
}

text SilphCo_7F_Text_JoshuaDefeat {
    "I'm done!$"
}

text SilphCo_7F_Text_JoshuaPostBattle {
    "Despite your age, you are a\n"
    "skilled Trainer!$"
}

text SilphCo_7F_Text_Grunt1Intro {
    "I am one of the four Rocket\n"
    "Brothers!$"
}

text SilphCo_7F_Text_Grunt1Defeat {
    "Aack!\n"
    "Brothers, I lost!$"
}

text SilphCo_7F_Text_Grunt1PostBattle {
    "Doesn't matter.\n"
    "My brothers will repay the favor!$"
}

text SilphCo_7F_Text_Grunt2Intro {
    "A child intruder?\n"
    "That must be you!$"
}

text SilphCo_7F_Text_Grunt2Defeat {
    "Fine!\n"
    "I lost!$"
}

text SilphCo_7F_Text_Grunt2PostBattle {
    "Go on home before my Boss gets\n"
    "ticked off!$"
}

text SilphCo_7F_Text_RivalWhatKeptYou {
    "{RIVAL}: What kept you, {PLAYER}?$"
}

text SilphCo_7F_Text_RivalIntro {
    "{RIVAL}: Hahaha! I thought you'd\n"
    "turn up if I waited here!\p"
    "I guess Team Rocket slowed you\n"
    "down! Not that I care!\p"
    "I saw you in Saffron, so I decided\n"
    "to see if you got better!$"
}

text SilphCo_7F_Text_RivalDefeat {
    "Oh, man!\n"
    "So, you are ready for Boss\l"
    "Rocket!$"
}

text SilphCo_7F_Text_RivalVictory {
    "{RIVAL}“おまえなあ‥\p"
    "こんな　うでまえじゃ\n"
    "まだまだ‥\l"
    "いちにんまえ　とは　いえないぜ$"
}

text SilphCo_7F_Text_RivalPostBattle {
    "Well, {PLAYER}!\n"
    "I'm moving on up and ahead!\p"
    "By checking my Pokédex, I'm\n"
    "starting to see what's strong and\l"
    "how they evolve!\p"
    "Am I a genius or what?\p"
    "I'm going to the Pokémon League to\n"
    "boot out the Elite Four.\p"
    "I'll become the world's most\n"
    "powerful Trainer!\p"
    "{PLAYER}, well, good luck to you!\n"
    "Don't sweat it!\l"
    "Smell ya!$"
}

text SilphCo_7F_Text_FloorSign {
    "Silph Co. Head Office\n"
    "7F$"
}
