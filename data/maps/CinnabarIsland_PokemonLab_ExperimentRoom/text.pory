text Text_MetronomeTeach {
    "Tch-tch-tch!\n"
    "I'll teach you a nifty move.\p"
    "Teach it to a Pokémon, and watch\n"
    "the fun unfold!\p"
    "It's a move called Metronome.\n"
    "Does it strike your fancy?$"
}

text Text_MetronomeDeclined {
    "I tell you, it's a lot of fun!$"
}

text Text_MetronomeWhichMon {
    "Okay!\n"
    "Which Pokémon should I teach?$"
}

text Text_MetronomeTaught {
    "Tch-tch-tch!\n"
    "That's the sound of a Metronome.\p"
    "It tweaks your Pokémon's brain into\n"
    "using moves it doesn't even know.$"
}

text CinnabarIsland_PokemonLab_ExperimentRoom_Text_HaveYouAFossilForMe {
    "Hiya!\p"
    "I am important doctor.\n"
    "Yes, very much so, indeed.\p"
    "Here, I study rare Pokémon fossils.\n"
    "All the time, I study.\p"
    "You!\n"
    "Have you a fossil for me?$"
}

text CinnabarIsland_PokemonLab_ExperimentRoom_Text_NoIsTooBad {
    "No!\n"
    "Is too bad!$"
}

// Unused
text CinnabarIsland_PokemonLab_ExperimentRoom_Text_TakesTimeGoForWalkJP {
    "ちょっと　じかん　かかるよ！\p"
    "そこらへんを　すこし\n"
    "ブラブラ　してくると　よろしー！$"
}

text CinnabarIsland_PokemonLab_ExperimentRoom_Text_FossilMonBackToLife {
    "You late.\n"
    "Where were you?\p"
    "Your fossil is back to life!\n"
    "It was {STR_VAR_1} like I think!$"
}

text CinnabarIsland_PokemonLab_ExperimentRoom_Text_ReceivedMonFromDoctor {
    "{PLAYER} received the {STR_VAR_1}\n"
    "from the doctor.$"
}

// Unused
text CinnabarIsland_PokemonLab_ExperimentRoom_Text_NoRoomForPokemon {
    "ポケモン　いっぱいで　もてないね！$"
}

text CinnabarIsland_PokemonLab_ExperimentRoom_Text_ThatFossilIsOfMonMakeItLiveAgain {
    "Oh!\n"
    "That is {STR_VAR_2}, it is!\p"
    "It is fossil of {STR_VAR_1},\n"
    "a Pokémon that is already extinct!\p"
    "My Resurrection Machine will make\n"
    "that Pokémon live again!$"
}

// TODO: Resolve text dump error below?
text CinnabarIsland_PokemonLab_ExperimentRoom_Text_HandedFossilToWeirdDoctor {
    "So!\n"
    "You hurry and give me that!\p"
    "{FONT_NORMAL}{PLAYER} handed over the\n"
    "{STR_VAR_2} to the weird doctor.$"
}

text CinnabarIsland_PokemonLab_ExperimentRoom_Text_TakesTimeGoForWalk {
    "I take a little time!\n"
    "You go for walk a little while!$"
}

text CinnabarIsland_PokemonLab_ExperimentRoom_Text_YouComeAgain {
    "Aiyah!\n"
    "You come again!$"
}
