text SaffronCity_CopycatsHouse_1F_Text_DaughterIsSelfCentered {
    "My daughter is so self-centered.\n"
    "She has but a few friends.$"
}

text SaffronCity_CopycatsHouse_1F_Text_DaughterLikesToMimicPeople {
    "My daughter likes to mimic people.\n"
    "It's rather vexing.\p"
    "Her mimicry has earned her the\n"
    "nickname COPYCAT around here.$"
}

text SaffronCity_CopycatsHouse_1F_Text_Chansey {
    "CHANSEY: Chaan! Sii!$"
}
