mapscripts PewterCity_Museum_2F_MapScripts {}

script PewterCity_Museum_2F_EventScript_Man {
    msgbox(PewterCity_Museum_1F_Text_WhatsSpecialAboutMoonStone, MSGBOX_NPC)
    end
}

script PewterCity_Museum_2F_EventScript_OldMan {
    msgbox(PewterCity_Museum_1F_Text_BoughtColorTVForMoonLanding, MSGBOX_NPC)
    end
}

script PewterCity_Museum_2F_EventScript_Scientist {
    msgbox(PewterCity_Museum_1F_Text_RunningSpaceExhibitThisMonth, MSGBOX_NPC)
    end
}

// Pikachu sidequest: the girl wants to see a Pikachu and her father asks the player to bring one.
// Showing her a Pikachu (talking to her with one in the party) earns a Light Ball from the father,
// but only once the father has asked for it; before that she doesn't notice the player's Pikachu.
script PewterCity_Museum_2F_EventScript_LittleGirl {
    lock
    faceplayer
    goto_if_set(FLAG_GOT_LIGHT_BALL_PEWTER_MUSEUM, PewterCity_Museum_2F_EventScript_LittleGirlAfterReward)
    if (flag(FLAG_PEWTER_MUSEUM_PIKACHU_REQUEST)) {
        call(PewterCity_Museum_2F_EventScript_CheckPartyHasPikachu)
        goto_if_eq(VAR_RESULT, TRUE, PewterCity_Museum_2F_EventScript_ShowPikachu)
    }
    msgbox(PewterCity_Museum_1F_Text_AskedDaddyToCatchPikachu)
    applymovement(LOCALID_MUSEUM_2F_LITTLE_GIRL, Common_Movement_FaceRight)
    waitmovement(0)
    release
    end
}

script PewterCity_Museum_2F_EventScript_LittleGirlAfterReward {
    msgbox(PewterCity_Museum_2F_Text_CantStopThinkingAboutPikachu)
    release
    end
}

// The father turns towards the side the player is talking to the girl from
script PewterCity_Museum_2F_EventScript_ShowPikachu {
    specialvar(VAR_RESULT, GetPlayerFacingDirection)
    switch (var(VAR_RESULT)) {
        case DIR_EAST:
            applymovement(LOCALID_MUSEUM_2F_BALDING_MAN, PewterCity_Museum_2F_Movement_FaceLeft)
        case DIR_SOUTH:
            applymovement(LOCALID_MUSEUM_2F_BALDING_MAN, PewterCity_Museum_2F_Movement_FaceUp)
        default:
            applymovement(LOCALID_MUSEUM_2F_BALDING_MAN, Common_Movement_FaceDown)
    }
    waitmovement(0)
    msgbox(PewterCity_Museum_2F_Text_PikaPikaCuterUpClose)
    textcolor(NPC_TEXT_COLOR_MALE)
    msgbox(PewterCity_Museum_2F_Text_YouMadeHerDay)
    giveitem(ITEM_LIGHT_BALL)
    goto_if_eq(VAR_RESULT, FALSE, EventScript_BagIsFull)
    setflag(FLAG_GOT_LIGHT_BALL_PEWTER_MUSEUM)
    release
    end
}

script PewterCity_Museum_2F_EventScript_BaldingMan {
    lock
    goto_if_set(FLAG_GOT_LIGHT_BALL_PEWTER_MUSEUM, PewterCity_Museum_2F_EventScript_BaldingManAfterReward)
    goto_if_set(FLAG_PEWTER_MUSEUM_PIKACHU_REQUEST, PewterCity_Museum_2F_EventScript_BaldingManReminder)
    call(PewterCity_Museum_2F_EventScript_DadAsksForPikachu)
    release
    end
}

script PewterCity_Museum_2F_EventScript_BaldingManReminder {
    msgbox(PewterCity_Museum_1F_Text_PikachuSoonIPromise)
    applymovement(LOCALID_MUSEUM_2F_BALDING_MAN, Common_Movement_FacePlayer)
    waitmovement(0)
    msgbox(PewterCity_Museum_2F_Text_RememberToBringPikachu)
    applymovement(LOCALID_MUSEUM_2F_BALDING_MAN, Common_Movement_FaceDown)
    waitmovement(0)
    release
    end
}

script PewterCity_Museum_2F_EventScript_BaldingManAfterReward {
    faceplayer
    msgbox(PewterCity_Museum_2F_Text_DaughterHasntStoppedTalking)
    release
    end
}

// The father notices the player and takes them one tile to the right (away from his daughter)
// to ask for a Pikachu. He always ends up at the right of his spot, the player next to him.
script PewterCity_Museum_2F_EventScript_DadAsksForPikachu {
    msgbox(PewterCity_Museum_1F_Text_PikachuSoonIPromise)
    playse(SE_PIN)
    applymovement(LOCALID_MUSEUM_2F_BALDING_MAN, PewterCity_Museum_2F_Movement_DadNoticePlayer)
    waitmovement(0)
    checkplayergender
    if (var(VAR_RESULT) == MALE) {
        msgbox(PewterCity_Museum_2F_Text_HeyYoungMan)
    } else {
        msgbox(PewterCity_Museum_2F_Text_HeyYoungLady)
    }
    specialvar(VAR_RESULT, GetPlayerFacingDirection)
    switch (var(VAR_RESULT)) {
        case DIR_WEST:
            // Player was at his right: both step right, side by side
            applymovement(LOCALID_PLAYER, PewterCity_Museum_2F_Movement_PlayerStepAsideFromRight)
            applymovement(LOCALID_MUSEUM_2F_BALDING_MAN, PewterCity_Museum_2F_Movement_DadStepAsideFaceRight)
        case DIR_SOUTH:
            // Player was above him: both step right, the player stays above him
            applymovement(LOCALID_PLAYER, PewterCity_Museum_2F_Movement_PlayerStepAsideFromAbove)
            applymovement(LOCALID_MUSEUM_2F_BALDING_MAN, PewterCity_Museum_2F_Movement_DadStepAsideFaceUp)
        default:
            // Player was below him: the tile at the right of the player is a wall, so the player
            // goes around through the father's spot and ends up above him
            applymovement(LOCALID_PLAYER, PewterCity_Museum_2F_Movement_PlayerStepAsideFromBelow)
            applymovement(LOCALID_MUSEUM_2F_BALDING_MAN, PewterCity_Museum_2F_Movement_DadStepAsideFaceUp)
    }
    waitmovement(LOCALID_PLAYER)
    waitmovement(LOCALID_MUSEUM_2F_BALDING_MAN)
    msgbox(PewterCity_Museum_2F_Text_CouldYouBringMePikachu)
    applymovement(LOCALID_MUSEUM_2F_BALDING_MAN, PewterCity_Museum_2F_Movement_DadStepBack)
    waitmovement(0)
    setflag(FLAG_PEWTER_MUSEUM_PIKACHU_REQUEST)
    return
}

// Output: VAR_RESULT = TRUE if there's a Pikachu (not an Egg) in the player's party
script PewterCity_Museum_2F_EventScript_CheckPartyHasPikachu {
    setvar(VAR_0x8004, 0)
    while (var(VAR_0x8004) < PARTY_SIZE) {
        specialvar(VAR_RESULT, GetPartyMonSpecies)
        if (var(VAR_RESULT) == SPECIES_PIKACHU) {
            setvar(VAR_RESULT, TRUE)
            return
        }
        addvar(VAR_0x8004, 1)
    }
    setvar(VAR_RESULT, FALSE)
    return
}

movement PewterCity_Museum_2F_Movement_DadNoticePlayer {
    delay_1
    delay_4
    emote_exclamation_mark
    face_player
}

movement PewterCity_Museum_2F_Movement_DadStepAsideFaceRight {
    walk_right
    face_right
}

movement PewterCity_Museum_2F_Movement_DadStepAsideFaceUp {
    walk_right
    face_up
}

movement PewterCity_Museum_2F_Movement_PlayerStepAsideFromRight {
    walk_right
    face_left
}

movement PewterCity_Museum_2F_Movement_PlayerStepAsideFromAbove {
    walk_right
    face_down
}

// Waits a bit so the father has started leaving his spot before the player walks into it
movement PewterCity_Museum_2F_Movement_PlayerStepAsideFromBelow {
    delay_8
    walk_up
    walk_up
    walk_right
    face_down
}

movement PewterCity_Museum_2F_Movement_DadStepBack {
    walk_left
    face_down
}

script PewterCity_Museum_2F_EventScript_SpaceShuttle {
    msgbox(PewterCity_Museum_1F_Text_SpaceShuttle, MSGBOX_SIGN)
    end
}

script PewterCity_Museum_2F_EventScript_MoonStone {
    msgbox(PewterCity_Museum_1F_Text_MeteoriteThatFellOnMtMoon, MSGBOX_SIGN)
    end
}

movement PewterCity_Museum_2F_Movement_FaceLeft {
    face_left
}

movement PewterCity_Museum_2F_Movement_FaceUp {
    face_up
}
