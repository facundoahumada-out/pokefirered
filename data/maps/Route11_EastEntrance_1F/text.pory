// Unclear where this is originally from
text Route11_EastEntrance_1F_Text_BagIsFull {
    "{PLAYER}{KUN}の　バッグ\n"
    "いっぱい　みたい　だね$"
}

text Route11_EastEntrance_1F_Text_ManInLavenderRatesNames {
    "Don't you think it's hard to think\n"
    "up good names for Pokémon?\p"
    "Especially if you've caught a\n"
    "whole bunch?\p"
    "In Lavender Town, there's a man\n"
    "who rates Pokémon nicknames.\p"
    "He can even help you rename your\n"
    "Pokémon, too.$"
}

text Route11_EastEntrance_1F_Text_RockTunnelToReachLavender {
    "If you're aiming to reach Lavender\n"
    "Town, take Rock Tunnel.\p"
    "You can get to Rock Tunnel from\n"
    "Cerulean City.$"
}
