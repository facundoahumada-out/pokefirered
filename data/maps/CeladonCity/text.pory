text CeladonCity_Text_GotMyKoffingInCinnabar {
    "I got my KOFFING in CINNABAR.\p"
    "It's usually nice, but it breathes\n"
    "poison when it's angry.$"
}

text CeladonCity_Text_GymIsGreatFullOfWomen {
    "Heheh! This GYM is great!\n"
    "It's full of women!$"
}

text CeladonCity_Text_GameCornerIsBadForCitysImage {
    "CELADON takes pride in its efforts\n"
    "to keep the city beautiful.\p"
    "That's why the new GAME CORNER is\n"
    "bad for our city's image.$"
}

text CeladonCity_Text_BlewItAllAtSlots {
    "Moan…\n"
    "I blew it all at the slots!\p"
    "I knew I should have cashed in my\n"
    "COINS for prizes!$"
}

text CeladonCity_Text_MyTrustedPalPoliwrath {
    "This is my trusted pal, POLIWRATH.\p"
    "It evolved from a POLIWHIRL when\n"
    "I used a WATER STONE.$"
}

text CeladonCity_Text_Poliwrath {
    "POLIWRATH: Ribi ribit!$"
}

text CeladonCity_Text_GetLostOrIllPunchYou {
    "What are you staring at?\n"
    "Get lost, or I'll punch you.$"
}

text CeladonCity_Text_KeepOutOfTeamRocketsWay {
    "Keep out of TEAM ROCKET's way!$"
}

text CeladonCity_Text_ExplainXAccuracyDireHit {
    "TRAINER TIPS\p"
    "X ACCURACY boosts the accuracy of\n"
    "techniques.\p"
    "DIRE HIT jacks up the likelihood\n"
    "of critical hits.\p"
    "Get your items at the CELADON\n"
    "DEPT. STORE!$"
}

text CeladonCity_Text_CitySign {
    "CELADON CITY\n"
    "The City of Rainbow Dreams$"
}

text CeladonCity_Text_GymSign {
    "CELADON CITY POKéMON GYM\n"
    "LEADER: ERIKA\l"
    "The Nature-Loving Princess!$"
}

text CeladonCity_Text_MansionSign {
    "CELADON MANSION$"
}

text CeladonCity_Text_DeptStoreSign {
    "Find what you need at the\n"
    "CELADON DEPT. STORE!$"
}

text CeladonCity_Text_GuardSpecProtectsFromStatus {
    "TRAINER TIPS\p"
    "GUARD SPEC. protects POKéMON\n"
    "from status-reduction moves during\l"
    "battle.\p"
    "Get your items at the\n"
    "CELADON DEPT. STORE!$"
}

text CeladonCity_Text_PrizeExchangeSign {
    "COINS exchanged for prizes!\n"
    "PRIZE EXCHANGE$"
}

text CeladonCity_Text_GameCornerSign {
    "ROCKET GAME CORNER\n"
    "The playground for grown-ups!$"
}

text CeladonCity_Text_ScaldedTongueOnTea {
    "Aaaagh, ow…\n"
    "I scalded my tongue!\p"
    "This nice old lady in the MANSION\n"
    "gave me some TEA.\p"
    "But it was boiling hot!\n"
    "Gotta cool it to drink it.$"
}

text Text_SoftboiledTeach {
    "Hello, there!\p"
    "I've seen you about, but I never\n"
    "had a chance to chat.\p"
    "It must be good luck that brought\n"
    "us together finally.\p"
    "I'd like to celebrate by teaching\n"
    "you the move SOFTBOILED.$"
}

text Text_SoftboiledDeclined {
    "I'll always be keeping an eye out\n"
    "for you.\p"
    "I hope we can chat again.$"
}

text Text_SoftboiledWhichMon {
    "So, who's the POKéMON that gets\n"
    "the chance to learn SOFTBOILED?$"
}

text Text_SoftboiledTaught {
    "I wish you the best of luck!$"
}

text CeladonCity_Text_SomeoneStoleSilphScope {
    "Oh, what am I to do…\p"
    "Someone stole our SILPH SCOPE.\p"
    "The thief came running this way,\n"
    "I'm sure of it.\p"
    "But I lost sight of him!\n"
    "Where'd he go?$"
}
