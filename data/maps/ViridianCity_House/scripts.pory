script ViridianCity_House_EventScript_Speary {
    lock
    faceplayer
    waitse
    playmoncry(SPECIES_SPEAROW, CRY_MODE_NORMAL)
    msgbox(ViridianCity_House_Text_Speary)
    waitmoncry
    release
    end
}

