text ViridianCity_House_Text_NicknamingIsFun {
    "Coming up with nicknames is fun,\n"
    "but it's not so easy to do.\p"
    "Clever names are nice, but simple\n"
    "names are easier to remember.$"
}

text ViridianCity_House_Text_MyDaddyLovesMonsToo {
    "My daddy loves Pokémon, too.$"
}

text ViridianCity_House_Text_Speary {
    "Speary: Tetweet!$"
