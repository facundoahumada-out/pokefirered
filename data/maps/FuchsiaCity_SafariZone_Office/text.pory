text FuchsiaCity_SafariZone_Office_Text_NicknamedWardenSlowpoke {
    "We nicknamed the Warden\n"
    "“Slowpoke.”\p"
    "You know, he has that vacant look\n"
    "like a Slowpoke.$"
}

text FuchsiaCity_SafariZone_Office_Text_WardenIsVeryKnowledgeable {
    "Warden Slowpoke is very\n"
    "knowledgeable about Pokémon.\p"
    "He even has some fossils of rare,\n"
    "extinct Pokémon.$"
}

text FuchsiaCity_SafariZone_Office_Text_CouldntUnderstandWarden {
    "Warden Slowpoke came in, but\n"
    "I couldn't understand him.\p"
    "I think he's got a speech problem!$"
}

text FuchsiaCity_SafariZone_Office_Text_PrizeInSafariZone {
    "Warden Slowpoke is running a\n"
    "promotion campaign right now.\p"
    "Try to get to the farthest corner\n"
    "of the Safari Zone.\p"
    "If you can make it, you'll win a\n"
    "very convenient prize.$"
}

text FuchsiaCity_SafariZone_Office_Text_ElementalPunchesIntro {
    "I can make your Pokémon's fists\n"
    "blaze with fire, crackle with\l"
    "lightning, or freeze like ice.\p"
    "If you're interested, I can teach\n"
    "one of the elemental punches\l"
    "whenever you want.$"
}

text FuchsiaCity_SafariZone_Office_Text_ShouldITeachMove {
    "Should I teach a move to one of\n"
    "your Pokémon?$"
}

text FuchsiaCity_SafariZone_Office_Text_WhichMoveShouldITeach {
    "Which move should I teach?$"
}

text FuchsiaCity_SafariZone_Office_Text_ElementalPunchesDeclined {
    "Come back if you change your mind.$"
}

text FuchsiaCity_SafariZone_Office_Text_ElementalPunchesTaught {
    "Come back anytime, trainer!\n"
    "My fists will always be ready.$"
}
