text FourIsland_Text_IslandSign {
    "Four Island\n"
    "The Warm, Blue, Floe Island$"
}

text FourIsland_Text_LoreleiHasReturned {
    "Lorelei has returned.\p"
    "Did she find the city life too\n"
    "stressful, I wonder?$"
}

text FourIsland_Text_LoreleiMetLaprasAsChild {
    "Lorelei has gone back.\p"
    "The Lapras she has, I imagine it\n"
    "to be the one she met as a child.\p"
    "I believe it was in Icefall Cave\n"
    "that she caught it.\p"
    "Perhaps that Pokémon has been with\n"
    "her ever since.$"
}

text FourIsland_Text_RivalAlreadyGotEggBeSmellingYa {
    "{RIVAL}: Hey!\n"
    "{PLAYER}!\p"
    "What are you doing here in the\n"
    "Sevii Islands?\p"
    "You should quit copying me,\n"
    "you know?\p"
    "Anyways, I already got my Pokémon\n"
    "Egg, so I'm done with this island.\p"
    "Heh, I bet you don't even know\n"
    "about Pokémon Eggs.\p"
    "You'll never fill your National\n"
    "Pokédex that way.\p"
    "By the way, I saw someone we both\n"
    "know on this island.\p"
    "Why don't you go look around if\n"
    "it makes you curious?\p"
    "Me, I don't have the time to\n"
    "waste.\p"
    "Be smelling ya!$"
}

text FourIsland_Text_LoreleiHasLotsOfStuffedDolls {
    "Oh, you found me!\n"
    "Please don't tell Lorelei.\p"
    "Did you know that Lorelei has lots\n"
    "and lots of stuffed dolls?\p"
    "Every time she comes back to\n"
    "Four Island, her collection grows!$"
}

text FourIsland_Text_MadeSlushieUsingIcefallCaveIce {
    "Ooh, chilly!\p"
    "I made a slushie using ice I\n"
    "shaved inside Icefall Cave.\p"
    "It's chilly and tasty!$"
}

text FourIsland_Text_LoreleisHouse {
    "Lorelei's House$"
}
