text SaffronCity_Dojo_Text_MasterKoichiIntro {
    "Grunt!\p"
    "I am the KARATE MASTER!\n"
    "I am the LEADER here!\p"
    "You wish to challenge us?\n"
    "Expect no mercy!\p"
    "Fwaaa!$"
}

text SaffronCity_Dojo_Text_MasterKoichiDefeat {
    "Hwa!\n"
    "Arrgh! Beaten!$"
}

text SaffronCity_Dojo_Text_ChoosePrizedFightingMon {
    "Indeed, I have lost!\p"
    "But, I beseech you, do not take\n"
    "our emblem as your trophy!\p"
    "In return, I will give you a prized\n"
    "FIGHTING POKéMON!\p"
    "Choose whichever one you like!$"
}

text SaffronCity_Dojo_Text_StayAndTrainWithUs {
    "Grunt!\n"
    "Stay and train at karate with us!$"
}

text SaffronCity_Dojo_Text_MikeIntro {
    "Hoargh!\n"
    "Take your shoes off!$"
}

text SaffronCity_Dojo_Text_MikeDefeat {
    "I give up!$"
}

text SaffronCity_Dojo_Text_MikePostBattle {
    "You wait 'til you see our MASTER!\n"
    "I'm a small fry compared to him!$"
}

text SaffronCity_Dojo_Text_HidekiIntro {
    "I hear you're good!\n"
    "Show me!$"
}

text SaffronCity_Dojo_Text_HidekiDefeat {
    "Judge!\n"
    "One point!$"
}

text SaffronCity_Dojo_Text_HidekiPostBattle {
    "Our MASTER is a pro fighter.\n"
    "Be prepared to lose!$"
}

text SaffronCity_Dojo_Text_AaronIntro {
    "Hiyah!\n"
    "I have no fear for anything tough!\p"
    "I shatter boulders for training\n"
    "every day!$"
}

text SaffronCity_Dojo_Text_AaronDefeat {
    "Yow!\n"
    "Stubbed fingers!$"
}

text SaffronCity_Dojo_Text_AaronPostBattle {
    "The only thing that frightens us is\n"
    "psychic power!$"
}

text SaffronCity_Dojo_Text_HitoshiIntro {
    "Hwaah!\p"
    "You're trespassing in our\n"
    "FIGHTING DOJO!$"
}

text SaffronCity_Dojo_Text_HitoshiDefeat {
    "Oof!\n"
    "I give up!$"
}

text SaffronCity_Dojo_Text_HitoshiPostBattle {
    "The prime fighters across the land\n"
    "train here.$"
}

text SaffronCity_Dojo_Text_YouWantHitmonlee {
    "You want the hard-kicking\n"
    "HITMONLEE?$"
}

text SaffronCity_Dojo_Text_ReceivedMonFromKarateMaster {
    "{PLAYER} received the {STR_VAR_1}\n"
    "from the KARATE MASTER.$"
}

text SaffronCity_Dojo_Text_YouWantHitmonchan {
    "You want the piston-punching\n"
    "HITMONCHAN?$"
}

text SaffronCity_Dojo_Text_ReceivedMonFromKarateMaster2 {
    "{PLAYER}は　カラテ　だいおう　から\n"
    "{STR_VAR_1}を　もらった！$"
}

text SaffronCity_Dojo_Text_BetterNotGetGreedy {
    "Better not get greedy…$"
}

text SaffronCity_Dojo_Text_EnemiesOnEverySide {
    "Enemies on every side!$"
}

text SaffronCity_Dojo_Text_GoesAroundComesAround {
    "What goes around comes around.$"
}

