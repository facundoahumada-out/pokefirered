text LavenderTown_Text_DoYouBelieveInGhosts {
    "Do you believe in ghosts?$"
}

text LavenderTown_Text_SoThereAreBelievers {
    "Really?\n"
    "So there are believers…$"
}

text LavenderTown_Text_JustImaginingWhiteHand {
    "Hahaha, I guess not.\p"
    "That white hand on your shoulder…\n"
    "I'm just imagining it.$"
}

text LavenderTown_Text_TownKnownAsMonGraveSite {
    "This town is known as the grave\n"
    "site of POKéMON.\p"
    "Memorial services are held in\n"
    "POKéMON TOWER.$"
}

text LavenderTown_Text_GhostsAppearedInTower {
    "Ghosts appeared in POKéMON TOWER.\p"
    "I think they're the spirits of\n"
    "POKéMON that the ROCKETS killed.$"
}

text LavenderTown_Text_TownSign {
    "LAVENDER TOWN\n"
    "The Noble Purple Town$"
}

text LavenderTown_Text_SilphScopeNotice {
    "New SILPH SCOPE!\n"
    "Make the Invisible Plain to See!\p"
    "SILPH CO.$"
}

text LavenderTown_Text_VolunteerPokemonHouse {
    "LAVENDER VOLUNTEER\n"
    "POKéMON HOUSE$"
}

text LavenderTown_Text_PokemonTowerSign {
    "POKéMON TOWER\n"
    "Becalm the Spirits of POKéMON$"
}
