text JPText_BodySlamTeach {
    "そーれ　ぼよーん！\n"
    "どっちが　さきに　へたばるか？\l"
    "のしかかり　しょうぶ　してるんだ\p"
    "きみは　なかまに　はいったら\n"
    "つぶれそうだな‥\l"
    "かわりに　きみの　ポケモンに\l"
    "のしかかり　おしえて　やろっか？$"
}

