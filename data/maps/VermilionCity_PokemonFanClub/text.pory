text VermilionCity_PokemonFanClub_Text_AdmirePikachusTail {
    "Won't you admire my Pikachu's\n"
    "adorable tail?$"
}

text VermilionCity_PokemonFanClub_Text_PikachuTwiceAsCute {
    "Humph!\p"
    "My Pikachu is twice as cute as\n"
    "that one!$"
}

text VermilionCity_PokemonFanClub_Text_AdoreMySeel {
    "I just adore my Seel!\n"
    "It's so lovable!\p"
    "It squeals, “Kyuuuh,” when I\n"
    "hug it!$"
}

text VermilionCity_PokemonFanClub_Text_SeelFarMoreAttractive {
    "Oh, dear!\p"
    "My Seel is far more attractive.\n"
    "By double, I would say.$"
}

text VermilionCity_PokemonFanClub_Text_Pikachu {
    "Pikachu: Chu! Pikachu!$"
}

text VermilionCity_PokemonFanClub_Text_Seel {
    "Seel: Kyuoo!$"
}

text VermilionCity_PokemonFanClub_Text_DidYouComeToHearAboutMyMons {
    "I chair the Pokémon Fan Club!\p"
    "I raise more than a hundred\n"
    "Pokémon!\p"
    "I'm very fussy when it comes to\n"
    "Pokémon! I surely am!\p"
    "So…\p"
    "Did you come visit to hear about\n"
    "my Pokémon?$"
}

text VermilionCity_PokemonFanClub_Text_ChairmansStory {
    "Good!\n"
    "Then listen up!\p"
    "My favorite Rapidash…\p"
    "It's…cute…lovely…smart… \n"
    "plus…amazing…you think so?…\l"
    "oh yes…it's…stunning…\l"
    "kindly…love it!\p"
    "Hug it…when…sleeping…warm\n"
    "and cuddly…spectacular…\l"
    "ravishing…\l"
    "…Oops! Look at the time!\l"
    "I kept you too long!\p"
    "Thanks for hearing me out!\n"
    "I want you to have this!$"
}

text VermilionCity_PokemonFanClub_Text_ReceivedBikeVoucherFromChairman {
    "{PLAYER} received a Bike Voucher\n"
    "from the Chairman.$"
}

text VermilionCity_PokemonFanClub_Text_ExplainBikeVoucher {
    "Take that Bike Voucher to the\n"
    "Bike Shop in Cerulean City.\p"
    "Exchange that for a Bicycle\n"
    "free of charge!\p"
    "Don't worry, my favorite Fearow\n"
    "will Fly me anywhere I need to go.\p"
    "So, I have no need for a Bicycle.\p"
    "I hope you like cycling!$"
}

text VermilionCity_PokemonFanClub_Text_ComeBackToHearStory {
    "Oh. Come back when you want to\n"
    "hear my story!$"
}

text VermilionCity_PokemonFanClub_Text_DidntComeToSeeAboutMonsAgain {
    "Hello, {PLAYER}!\p"
    "Did you come see me about my\n"
    "Pokémon again?\p"
    "No?\n"
    "Too bad!$"
}

text VermilionCity_PokemonFanClub_Text_MakeRoomForThis {
    "Make room for this!$"
}

text VermilionCity_PokemonFanClub_Text_ChairmanVeryVocalAboutPokemon {
    "Our Chairman is very vocal about\n"
    "Pokémon.$"
}

text VermilionCity_PokemonFanClub_Text_ListenPolitelyToOtherTrainers {
    "Let's all listen politely to other\n"
    "Trainers!$"
}

text VermilionCity_PokemonFanClub_Text_SomeoneBragsBragBack {
    "If someone brags, brag right back!$"
}

text VermilionCity_PokemonFanClub_Text_ChairmanReallyAdoresHisMons {
    "Our Chairman really does adore his\n"
    "Pokémon.\p"
    "But the person who is most liked by\n"
    "Pokémon is Daisy, I think.$"
}
