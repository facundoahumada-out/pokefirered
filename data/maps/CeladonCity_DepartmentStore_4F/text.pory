text CeladonCity_DepartmentStore_4F_Text_GettingPokeDollAsPresent {
    "I'm getting a present for my\n"
    "girlfriend.\p"
    "I guess a POKé DOLL will be it.\n"
    "It's the popular thing.$"
}

text CeladonCity_DepartmentStore_4F_Text_CanRunAwayWithPokeDoll {
    "I heard something useful.\p"
    "If a wild POKéMON appears, you can\n"
    "distract it with a POKé DOLL.\p"
    "You can run away while the wild\n"
    "POKéMON is distracted.$"
}

text CeladonCity_DepartmentStore_4F_Text_FloorSign {
    "Express yourself with gifts!\n"
    "4F: WISE MAN GIFTS\p"
    "Evolution Special!\n"
    "Element STONES on sale now!$"
}
