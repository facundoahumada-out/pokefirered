text SaffronCity_CopycatsHouse_2F_Text_MimickingFavoriteHobbyMale {
    "{PLAYER}: Hi!\n"
    "Do you like POKéMON?\p"
    "{PLAYER}: Uh, no, I just asked you.\p"
    "{PLAYER}: Huh?\n"
    "You're strange!\p"
    "COPYCAT: Hmm? Quit mimicking?\n"
    "But, that's my favorite hobby!$"
}

text SaffronCity_CopycatsHouse_2F_Text_MimickingFavoriteHobbyFemale {
    "{PLAYER}: Hi.\n"
    "You must like POKéMON.\p"
    "{PLAYER}: No, not me.\n"
    "I asked you.\p"
    "{PLAYER}: Pardon?\n"
    "You're weird!\l"
    " \l"
    "COPYCAT: Hmm? Quit mimicking?\l"
    "But that's my favorite hobby!$"
}

text Text_MimicTeach {
    "Oh wow!\n"
    "A POKé DOLL!\p"
    "For me?\n"
    "Thank you!\p"
    "You know what?\n"
    "I can teach the move MIMIC.$"
}

text Text_MimicDeclined {
    "Don't you like MIMIC?$"
}

text Text_MimicWhichMon {
    "I really love MIMIC!\n"
    "Who's going to learn it?$"
}

text Text_MimicTaughtMale {
    "{PLAYER}: Hi!\n"
    "Thanks for earlier!\p"
    "{PLAYER}: Pardon?\p"
    "{PLAYER}: Is it that fun to mimic my\n"
    "every move?\p"
    "COPYCAT: You bet!\n"
    "It's a scream!$"
}

text Text_MimicTaughtFemale {
    "{PLAYER}: Hi!\n"
    "Thanks for what you did for us.\p"
    "{PLAYER}: Pardon?\p"
    "{PLAYER}: Is it really that fun to\n"
    "copy what I say and do?\p"
    "COPYCAT: You bet!\n"
    "It's a scream!$"
}

