text SaffronCity_CopycatsHouse_2F_Text_MimickingFavoriteHobbyMaleJP {
    "{PLAYER}“やあ！　こんにちは！\n"
    "きみ　ポケモン　すきかい？\p"
    "{PLAYER}“ぼく　じゃなくって\n"
    "きみに　きいてるんだ　けど\p"
    "{PLAYER}“‥‥　えー　なんだよ！\n"
    "ヘンな　やつ　だなあ！\p"
    "モノマネむすめ“‥‥　なに？\n"
    "ひとの　マネ　すんなって？\p"
    "だって　あたし　\n"
    "ものまね　しゅみ　なんだ　もん！”$"
}

text SaffronCity_CopycatsHouse_2F_Text_MimickingFavoriteHobbyFemaleJP {
    "{PLAYER}“こんにちは！\n"
    "ポケモン　すきなのね？\p"
    "{PLAYER}“わたし　じゃなくって\n"
    "あなたに　きいてるんだ　けど\p"
    "{PLAYER}“‥　えー　なんなの！\n"
    "おかしなこ　ねー！\p"
    "モノマネむすめ“‥　なに？\n"
    "ひとの　マネ　すんなって？\p"
    "だって　あたし\n"
    "ものまね　しゅみ　なんだ　もん！$"
}

