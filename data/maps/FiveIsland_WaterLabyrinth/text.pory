text FiveIsland_WaterLabyrinth_Text_LetMeTakeLookAtMons {
    "You travel all over the place,\n"
    "don't you?\p"
    "You're not driving your POKéMON\n"
    "too harshly, are you?\p"
    "Let me take a look.\n"
    "… … …   … … …$"
}

text FiveIsland_WaterLabyrinth_Text_HmmISeeIsee {
    "Ah, hmm…\n"
    "I see, I see…$"
}

text FiveIsland_WaterLabyrinth_Text_TreatMonRightHaveThis {
    "Oh, impressive.\n"
    "You treat your POKéMON right.\p"
    "I think you can be entrusted with\n"
    "this.\p"
    "Please, I'd like you to have this.$"
}

text FiveIsland_WaterLabyrinth_Text_ReceivedEggFromMan {
    "{PLAYER} received an EGG\n"
    "from the man!$"
}

text FiveIsland_WaterLabyrinth_Text_DontHaveSpaceInYourParty {
    "…Unfortunately, you don't have\n"
    "space for this in your party.\p"
    "You'd better come back for it\n"
    "another time.$"
}

// Unused
text FiveIsland_WaterLabyrinth_Text_YouveComeBackForTheEgg {
    "やあ\n"
    "タマゴを　もらいに\l"
    "きて　くれたんだね$"
}

text FiveIsland_WaterLabyrinth_Text_GladIMetSomeoneLikeYou {
    "I received that EGG while I was\n"
    "traveling.\p"
    "I'm glad I met someone like you.$"
}

text FiveIsland_WaterLabyrinth_Text_CuteMonRemindsMeOfDaisy {
    "Oh, hello.\n"
    "That's a cute {STR_VAR_2}.\p"
    "Seeing it reminds me of a sweet \n"
    "little girl I met while traveling.\p"
    "She was gently grooming POKéMON…\n"
    "She was a little angel.\p"
    "That little girl's name…\n"
    "I think it was DAISY.$"
}

text FiveIsland_WaterLabyrinth_Text_AlizeIntro {
    "This is an excellent environment\n"
    "for raising POKéMON.$"
}

text FiveIsland_WaterLabyrinth_Text_AlizeDefeat {
    "Your POKéMON are growing up\n"
    "admirably well!$"
}

text FiveIsland_WaterLabyrinth_Text_AlizePostBattle {
    "You know, I think you have the\n"
    "talent to be a good BREEDER.$"
}
