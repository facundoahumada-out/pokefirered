text SSAnne_2F_Room2_Text_BrooksIntro {
    "Competing against the young keeps\n"
    "me youthful.$"
}

text SSAnne_2F_Room2_Text_BrooksDefeat {
    "Good match!\n"
    "Ah, I feel young again!$"
}

text SSAnne_2F_Room2_Text_BrooksPostBattle {
    "Fifteen years ago, I would\n"
    "have won!$"
}

text SSAnne_2F_Room2_Text_DaleIntro {
    "Check out what I fished up!$"
}

text SSAnne_2F_Room2_Text_DaleDefeat {
    "I'm all out!$"
}

text SSAnne_2F_Room2_Text_DalePostBattle {
    "Party?\p"
    "The cruise ship's party should be\n"
    "over by now.$"
}
