text CeladonCity_DepartmentStore_5F_Text_ExplainStatEnhancers {
    "POKéMON stat enhancers can be\n"
    "bought only here.\p"
    "HP UP increases the base HP of a\n"
    "POKéMON.\p"
    "CALCIUM raises the base SP. ATK\n"
    "stat of one POKéMON.\p"
    "ZINC boosts the base SP. DEF stat\n"
    "of one POKéMON.\p"
    "CARBOS enhances the base SPEED\n"
    "stat.$"
}

text CeladonCity_DepartmentStore_5F_Text_HereForStatEnhancers {
    "I'm here for POKéMON stat\n"
    "enhancers.\p"
    "PROTEIN increases the base ATTACK\n"
    "power.\p"
    "IRON increases the base DEFENSE\n"
    "stat.$"
}

text CeladonCity_DepartmentStore_5F_Text_Drugstore {
    "5F: DRUGSTORE$"
}
