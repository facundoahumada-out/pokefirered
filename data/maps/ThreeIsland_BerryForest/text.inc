ThreeIsland_BerryForest_Text_HelpScaryPokemon::
# 1 "data/maps/ThreeIsland_BerryForest/text.pory"
	.string "Lostelle: Whimper… Sniff…\n"
	.string "Oh! Please, help!\p"
	.string "A scary Pokémon appeared there\n"
	.string "a little while ago.\p"
	.string "It kept scaring.\n"
	.string "It made Lostelle scared.\p"
	.string "I'm too scared to move!\n"
	.string "But I want to go home…$"

ThreeIsland_BerryForest_Text_HereItComesAgain::
# 12 "data/maps/ThreeIsland_BerryForest/text.pory"
	.string "Oh! Here it comes again!\n"
	.string "No! Go away! It's scaring me!\p"
	.string "Waaaaaaah!\n"
	.string "I want my daddy!$"

ThreeIsland_BerryForest_Text_ThankYouHaveThis::
# 19 "data/maps/ThreeIsland_BerryForest/text.pory"
	.string "Ohh! That was so scary!\n"
	.string "Thank you!\p"
	.string "Lostelle came to pick some\n"
	.string "Berries.\p"
	.string "You can have this!$"

ThreeIsland_BerryForest_Text_LetsGoHome::
# 27 "data/maps/ThreeIsland_BerryForest/text.pory"
	.string "What's your name?\p"
	.string "Lostelle's scared, so can I go\n"
	.string "with you to my daddy's house?\p"
	.string "Okay!\n"
	.string "Let's go home!$"

ThreeIsland_BerryForest_Text_BerryPouchIsFull::
# 35 "data/maps/ThreeIsland_BerryForest/text.pory"
	.string "Your Berry Pouch is full.\n"
	.string "I guess you don't want this.$"

ThreeIsland_BerryForest_Text_WelcomeToBerryForest::
# 40 "data/maps/ThreeIsland_BerryForest/text.pory"
	.string "Welcome to the Berry Forest\p"
	.string "Be friendly and share Berries with\n"
	.string "others and Pokémon.$"

ThreeIsland_BerryForest_Text_BewareWildBerryLovingMons::
# 46 "data/maps/ThreeIsland_BerryForest/text.pory"
	.string "Beware of wild, Berry-loving\n"
	.string "Pokémon!$"

ThreeIsland_BerryForest_Text_DailyKogaIntro::
# 51 "data/maps/ThreeIsland_BerryForest/text.pory"
	.string "So, it is you… Kanto's new Pokémon\n"
	.string "League Champion.\p"
	.string "Your victory proves your skill,\n"
	.string "but true mastery cannot be\l"
	.string "achieved through a single triumph.\p"
	.string "Even a victorious warrior must\n"
	.string "continue to perfect their art.\p"
	.string "I train in this forest, far from\n"
	.string "the distractions of the outside\l"
	.string "world.\p"
	.string "Tell me, Champion… Will you accept\n"
	.string "my challenge and test your skills\l"
	.string "against mine in a rematch?$"

ThreeIsland_BerryForest_Text_DailyKogaAccept::
# 67 "data/maps/ThreeIsland_BerryForest/text.pory"
	.string "Very well. Empty your mind,\n"
	.string "observe your opponent, and\l"
	.string "underestimate no move.\p"
	.string "Let our battle begin!$"

ThreeIsland_BerryForest_Text_DailyKogaDeclined::
# 74 "data/maps/ThreeIsland_BerryForest/text.pory"
	.string "I understand. A ninja knows that\n"
	.string "not every battle must be fought in\l"
	.string "the present moment.\p"
	.string "Our paths shall cross again.$"

ThreeIsland_BerryForest_Text_DailyKogaPostBattle::
# 81 "data/maps/ThreeIsland_BerryForest/text.pory"
	.string "Your skills continue to sharpen,\n"
	.string "Champion.\p"
	.string "I shall spend the coming days\n"
	.string "refining my techniques.\p"
	.string "Seek me here next Friday, and we\n"
	.string "shall test our resolve once more.$"
