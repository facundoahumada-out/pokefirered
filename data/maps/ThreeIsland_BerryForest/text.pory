text ThreeIsland_BerryForest_Text_HelpScaryPokemon {
    "Lostelle: Whimper… Sniff…\n"
    "Oh! Please, help!\p"
    "A scary Pokémon appeared there\n"
    "a little while ago.\p"
    "It kept scaring.\n"
    "It made Lostelle scared.\p"
    "I'm too scared to move!\n"
    "But I want to go home…$"
}

text ThreeIsland_BerryForest_Text_HereItComesAgain {
    "Oh! Here it comes again!\n"
    "No! Go away! It's scaring me!\p"
    "Waaaaaaah!\n"
    "I want my daddy!$"
}

text ThreeIsland_BerryForest_Text_ThankYouHaveThis {
    "Ohh! That was so scary!\n"
    "Thank you!\p"
    "Lostelle came to pick some\n"
    "Berries.\p"
    "You can have this!$"
}

text ThreeIsland_BerryForest_Text_LetsGoHome {
    "What's your name?\p"
    "Lostelle's scared, so can I go\n"
    "with you to my daddy's house?\p"
    "Okay!\n"
    "Let's go home!$"
}

text ThreeIsland_BerryForest_Text_BerryPouchIsFull {
    "Your Berry Pouch is full.\n"
    "I guess you don't want this.$"
}

text ThreeIsland_BerryForest_Text_WelcomeToBerryForest {
    "Welcome to the Berry Forest\p"
    "Be friendly and share Berries with\n"
    "others and Pokémon.$"
}

text ThreeIsland_BerryForest_Text_BewareWildBerryLovingMons {
    "Beware of wild, Berry-loving\n"
    "Pokémon!$"
}

text ThreeIsland_BerryForest_Text_DailyKogaIntro {
    "So, it is you… Kanto's new Pokémon\n"
    "League Champion.\p"
    "Your victory proves your skill,\n"
    "but true mastery cannot be\l"
    "achieved through a single triumph.\p"
    "Even a victorious warrior must\n"
    "continue to perfect their art.\p"
    "I train in this forest, far from\n"
    "the distractions of the outside\l"
    "world.\p"
    "Tell me, Champion… Will you accept\n"
    "my challenge and test your skills\l"
    "against mine in a rematch?$"
}

text ThreeIsland_BerryForest_Text_DailyKogaAccept {
    "Very well. Empty your mind,\n"
    "observe your opponent, and\l"
    "underestimate no move.\p"
    "Let our battle begin!$"
}

text ThreeIsland_BerryForest_Text_DailyKogaDeclined {
    "I understand. A ninja knows that\n"
    "not every battle must be fought in\l"
    "the present moment.\p"
    "Our paths shall cross again.$"
}

text ThreeIsland_BerryForest_Text_DailyKogaPostBattle {
    "Your skills continue to sharpen,\n"
    "Champion.\p"
    "I shall spend the coming days\n"
    "refining my techniques.\p"
    "Seek me here next Friday, and we\n"
    "shall test our resolve once more.$"
}
