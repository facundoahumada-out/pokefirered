text SixIsland_DottedHole_SapphireRoom_Text_FoundSapphire {
    "{PLAYER} found a SAPPHIRE!$"
}

text SixIsland_DottedHole_SapphireRoom_Text_IWasRightInTailingYou {
    "Fufu… Fufufufu…\n"
    "I guessed right.\p"
    "I was right in tailing you!$"
}

text SixIsland_DottedHole_SapphireRoom_Text_SellToTeamRocketTellPassword {
    "I knew that there was a SAPPHIRE\n"
    "here, so it belongs to me!\p"
    "I'll sell it to TEAM ROCKET for\n"
    "serious money.\p"
    "…D-don't glare at me like that!\p"
    "If you want it back, why don't you\n"
    "go get it after I sell it?\p"
    "I'll even tell you one of the\n"
    "passwords to TEAM ROCKET's\l"
    "WAREHOUSE.\p"
    "The WAREHOUSE password I know is\n"
    "“Yes, nah, CHANSEY.”\p"
    "I'm done.\n"
    "Don't think badly of me!$"
}
