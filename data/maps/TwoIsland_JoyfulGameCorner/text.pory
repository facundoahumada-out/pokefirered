text TwoIsland_JoyfulGameCorner_Text_WhereHasLostelleGottenTo {
    "Now, where's Lostelle gotten to\n"
    "today?\p"
    "She always brings me lunch every\n"
    "day right about now…$"
}

text TwoIsland_JoyfulGameCorner_Text_PleaseHelpFindLostelle {
    "Hm? You, there!\n"
    "Are you a friend of Lostelle's?\p"
    "Have you seen Lostelle around?\n"
    "I don't know where she might be.\l"
    "She should've been here long ago.\p"
    "Lostelle's a cutie - she got my\n"
    "looks - so what if someone…\p"
    "What if something's happened to\n"
    "my Lostelle?!\p"
    "Please, help me find her!\n"
    "Please go search Three Island!$"
}

text TwoIsland_JoyfulGameCorner_Text_IsThisOnlyThreeIsland {
    "Hah? What is this Game Corner?\n"
    "How much sadder can this get?\p"
    "Those clowns…\p"
    "They said they'd be waiting on the\n"
    "island, so where are they?\p"
    "Hey, you! Is this the only Three\n"
    "Island around here?$"
}

text TwoIsland_JoyfulGameCorner_Text_ThisIsTwoIslandMoveIt {
    "Try waking up before you crawl out\n"
    "of bed, you punk.\p"
    "This is Two Island!\p"
    "Move it! Get your filthy motorbike\n"
    "out of my place!$"
}

text TwoIsland_JoyfulGameCorner_Text_TheseIslandsAreConfusing {
    "Huh…\n"
    "Oh, oh, gotcha.\p"
    "Tch…\n"
    "These islands are confusing…$"
}

text TwoIsland_JoyfulGameCorner_Text_PunkScuffedUpMyFloor {
    "Would you look at that?\n"
    "That punk scuffed up my floor.$"
}

text TwoIsland_JoyfulGameCorner_Text_PleaseGoToThreeIsland {
    "Hey, but listen! I'm begging you,\n"
    "you have to go to Three Island.\p"
    "If anything were to happen to my\n"
    "Lostelle…\p"
    "My place is the house with the red\n"
    "roof on Three Island.\p"
    "She may just show up late here,\n"
    "so I can't run off anywhere.\p"
    "That's why I have to get you to do\n"
    "me this big favor.$"
}

text TwoIsland_JoyfulGameCorner_Text_NotRunningAnyGamesToday {
    "I'm sorry.\n"
    "We're not running any games today.$"
}

text TwoIsland_JoyfulGameCorner_Text_GetGamesGoingSoon {
    "We'll get the games going soon\n"
    "for you!$"
}

text TwoIsland_JoyfulGameCorner_Text_YouRescuedLostelle {
    "So you rescued Lostelle?\n"
    "How can I thank you?\p"
    "Lostelle, darling, forgive me!\p"
    "Daddy didn't know you were scared\n"
    "and in trouble!$"
}

text TwoIsland_JoyfulGameCorner_Text_LostelleItsOkayDaddy {
    "Lostelle: It's okay, Daddy.\n"
    "I got to be friends with {PLAYER}!$"
}

text TwoIsland_JoyfulGameCorner_Text_ThisIsForMe {
    "Oh, what's that?\n"
    "You're saying that this is for me?\p"
    "How did you know that I love rare\n"
    "rocks and gems?\p"
    "You sure know how to make a guy\n"
    "happy.$"
}

text TwoIsland_JoyfulGameCorner_Text_HandedMeteoriteToLostellesDaddy {
    "{PLAYER} handed the Meteorite\n"
    "to Lostelle's daddy.$"
}

text TwoIsland_JoyfulGameCorner_Text_OhThisIsFromBill {
    "Oh, I see, this is from Bill!\n"
    "You have to thank him for me!\p"
    "You know, you've been fantastic.\n"
    "I want you to have this.$"
}

text TwoIsland_JoyfulGameCorner_Text_ReceivedMoonStoneFromLostellesDaddy {
    "{PLAYER} received a Moon Stone\n"
    "from Lostelle's daddy.$"
}

text TwoIsland_JoyfulGameCorner_Text_NotGoingToFitInBag {
    "Your Bag's not going to fit another\n"
    "thing…$"
}

text TwoIsland_JoyfulGameCorner_Text_IllGetGameCornerRunning {
    "All right, I'll get the Game Corner\n"
    "running right away.\p"
    "You have to come visit with a\n"
    "friend.$"
}

text TwoIsland_JoyfulGameCorner_Text_PleaseShowMeYouBeingCool {
    "Listen, listen!\p"
    "Please show me you being cool\n"
    "again!$"
}
