text VermilionCity_Text_GrimerMultipliesInSludge {
    "We're careful about pollution here.\p"
    "We've heard GRIMER multiplies in\n"
    "toxic sludge.$"
}

text VermilionCity_Text_DidYouSeeSSAnneInHarbor {
    "Did you see the S.S. ANNE moored\n"
    "in the harbor?$"
}

text VermilionCity_Text_SSAnneHasDepartedForYear {
    "So, the S.S. ANNE has departed?\p"
    "She'll be back in VERMILION about\n"
    "this time next year.$"
}

text VermilionCity_Text_BuildingOnThisLand {
    "I'm putting up a building on this\n"
    "plot of land. I own it all.\p"
    "My POKéMON is tamping the land\n"
    "to lay the foundation.$"
}

text VermilionCity_Text_Machop {
    "MACHOP: Guoh! Gogogoh!$"
}

text VermilionCity_Text_MachopStompingLandFlat {
    "A MACHOP is stomping the land flat.$"
}

text VermilionCity_Text_SSAnneVisitsOnceAYear {
    "The S.S. ANNE is a famous luxury\n"
    "cruise ship.\p"
    "It visits VERMILION once a year.$"
}

text VermilionCity_Text_CitySign {
    "VERMILION CITY\n"
    "The Port of Exquisite Sunsets$"
}

text VermilionCity_Text_SnorlaxBlockingRoute12 {
    "NOTICE!\p"
    "ROUTE 12 may be blocked off by a\n"
    "sleeping POKéMON.\p"
    "Detour through ROCK TUNNEL to\n"
    "LAVENDER TOWN.\p"
    "VERMILION POLICE$"
}

text VermilionCity_Text_PokemonFanClubSign {
    "POKéMON FAN CLUB\n"
    "All POKéMON fans welcome!$"
}

text VermilionCity_Text_GymSign {
    "VERMILION CITY POKéMON GYM\n"
    "LEADER: LT. SURGE\l"
    "The Lightning American!$"
}

text VermilionCity_Text_VermilionHarbor {
    "VERMILION HARBOR$"
}

text VermilionCity_Text_WelcomeToTheSSAnne {
    "Welcome to the S.S. ANNE!$"
}

text VermilionCity_Text_DoYouHaveATicket {
    "Welcome to the S.S. ANNE!\p"
    "Excuse me, do you have a ticket?$"
}

text VermilionCity_Text_FlashedSSTicket {
    "{FONT_NORMAL}{PLAYER} flashed the S.S. TICKET!\p"
    "{FONT_MALE}Great!\n"
    "Welcome to the S.S. ANNE!$"
}

text VermilionCity_Text_DontHaveNeededSSTicket {
    "{FONT_NORMAL}{PLAYER} doesn't have the needed\n"
    "S.S. TICKET.\p"
    "{FONT_MALE}Sorry!\p"
    "You need a ticket to get aboard.$"
}

text VermilionCity_Text_TheShipSetSail {
    "The ship set sail.$"
}

text VermilionCity_Text_BoardSeagallopTriPass {
    "Ah, you have a TRI-PASS.\p"
    "Would you like to board\n"
    "a SEAGALLOP ferry?$"
}

text VermilionCity_Text_Seagallop7Departing {
    "Okay, everything's in order.\p"
    "SEAGALLOP HI-SPEED 7 will be\n"
    "departing immediately.$"
}

text VermilionCity_Text_BoardSeagallopRainbowPass {
    "Ah, you have a RAINBOW PASS.\p"
    "Would you like to board\n"
    "a SEAGALLOP ferry?$"
}

text VermilionCity_Text_OhMysticTicketTakeYouToNavelRock {
    "Oh! That's a MYSTICTICKET!\n"
    "Now that is rare.\p"
    "We'll be happy to take you to\n"
    "NAVEL ROCK anytime.$"
}

text VermilionCity_Text_OhAuroraTicketTakeYouToBirthIsland {
    "Oh! That's an AURORATICKET!\n"
    "Now that is rare.\p"
    "We'll be happy to take you to\n"
    "BIRTH ISLAND anytime.$"
}

text VermilionCity_Text_BoardSeagallopFerry {
    "Would you like to board\n"
    "a SEAGALLOP ferry?$"
}

text VermilionCity_Text_Seagallop10Departing {
    "Okay, everything's in order for you\n"
    "to board a special ferry.\p"
    "SEAGALLOP HI-SPEED 10 will be\n"
    "departing immediately.$"
}

text VermilionCity_Text_Seagallop12Departing {
    "Okay, everything's in order for you\n"
    "to board a special ferry.\p"
    "SEAGALLOP HI-SPEED 12 will be\n"
    "departing immediately.$"
}

text VermilionCity_Text_Route2AideHasPackageForYou {
    "Oh, hello, {PLAYER}!\n"
    "How are you doing?\p"
    "It's me, one of PROF. OAK's AIDES.\p"
    "Did you meet the other AIDE?\p"
    "He had a package from PROF. OAK\n"
    "for you, {PLAYER}.\p"
    "He said he'd look for you around\n"
    "ROUTE 2, {PLAYER}.\p"
    "If you're in the ROUTE 2 area,\n"
    "please look for him.$"
}
