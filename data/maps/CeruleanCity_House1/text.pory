text CeruleanCity_House1_Text_SpStatsWaterfall {
    "The Sp. Atk and Sp. Def stats of\n"
    "all your Pokémon rise a little bit.\p"
    "It also lets you use the move\n"
    "Waterfall outside of battle.$"
}

text CeruleanCity_House1_Text_AllMonsWillObeyYou {
    "All Pokémon will obey you!$"
}
