text FuchsiaCity_House1_Text_WardenIsOldHasFalseTeeth {
    "The Safari Zone's Warden is old, \n"
    "but he's still very much active.\p"
    "All his teeth are false, though.$"
}

text FuchsiaCity_House1_Text_BillIsMyGrandson {
    "Hmm?\n"
    "You've met Bill?\p"
    "He's my grandson!\p"
    "He always liked collecting things,\n"
    "even as a child!$"
}

text FuchsiaCity_House1_Text_BillFilesHisOwnMonData {
    "Bill files his own Pokémon data on\n"
    "his PC.\p"
    "Did he show you?$"
}
