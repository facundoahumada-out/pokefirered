script EventScript_CanOnlyBeLearnedOnce {
    textcolor(NPC_TEXT_COLOR_NEUTRAL)
    special(DisableMsgBoxWalkaway)
    signmsg
    msgbox(Text_MoveCanOnlyBeLearnedOnce, MSGBOX_YESNO)
    normalmsg
    call(EventScript_RestorePrevTextColor)
    return
}

movement Movement_JumpInPlaceDown {
    jump_in_place_down
    step_end
}

movement Movement_JumpInPlaceUp {
    jump_in_place_up
    step_end
}

movement Movement_JumpInPlaceLeft {
    jump_in_place_left
    step_end
}

movement Movement_JumpInPlaceRight {
    jump_in_place_right
    step_end
}

// Lessons after the first one, which is free, cost money (the price depends on the move, see sTutorMovePrices).
// Input: VAR_0x8005 = MOVETUTOR_* of the tutor. Output: VAR_RESULT = TRUE if a Pokémon learned the move.
script EventScript_PaidMoveTutorLesson {
    showmoneybox(0, 0) // Before buffering: the money box overwrites STR_VAR_1
    special(BufferMoveTutorPrice)
    msgbox(Text_MoveTutorTeachAgainForMoney, MSGBOX_YESNO)
    goto_if_eq(VAR_RESULT, NO, EventScript_PaidMoveTutorLessonDeclined)
    specialvar(VAR_RESULT, CanPayMoveTutorPrice)
    goto_if_eq(VAR_RESULT, FALSE, EventScript_PaidMoveTutorLessonNotEnoughMoney)
    msgbox(Text_MoveTutorWhichMon)
    closemessage
    hidemoneybox
    call(EventScript_ChooseMoveTutorMon)
    goto_if_eq(VAR_RESULT, FALSE, EventScript_PaidMoveTutorLessonNotTaught)
    special(PayMoveTutorPrice)
    showmoneybox(0, 0) // Before buffering: the money box overwrites STR_VAR_1
    special(BufferMoveTutorPrice)
    playse(SE_SHOP)
    msgbox(Text_MoveTutorPaid)
    waitse
    hidemoneybox
    setvar(VAR_RESULT, TRUE)
    return
}

script EventScript_PaidMoveTutorLessonNotEnoughMoney {
    msgbox(Text_MoveTutorNotEnoughMoney)
    goto(EventScript_PaidMoveTutorLessonDeclined)
}

script EventScript_PaidMoveTutorLessonDeclined {
    hidemoneybox
    goto(EventScript_PaidMoveTutorLessonNotTaught)
}

script EventScript_PaidMoveTutorLessonNotTaught {
    setvar(VAR_RESULT, FALSE)
    return
}

text Text_MoveTutorTeachAgainForMoney {
    "I can teach {STR_VAR_1} to another\n"
    "Pokémon for ¥{STR_VAR_2}.\p"
    "Would you like that?$"
}

text Text_MoveTutorWhichMon {
    "Which Pokémon should learn\n"
    "{STR_VAR_1}?$"
}

text Text_MoveTutorNotEnoughMoney {
    "Oh, you don't have enough money.$"
}

text Text_MoveTutorPaid {
    "{PLAYER} handed over ¥{STR_VAR_2}.$"
}
