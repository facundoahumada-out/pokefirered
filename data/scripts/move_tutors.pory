    setvar(VAR_0x8005, MOVETUTOR_DOUBLE_EDGE)
    call(EventScript_PaidMoveTutorLesson)
    goto_if_eq(VAR_RESULT, FALSE, EventScript_DoubleEdgeDeclined)
    goto(EventScript_DoubleEdgeTaught)
    end
}

