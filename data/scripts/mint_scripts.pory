// Shared mint pickup script
script Common_EventScript_FindMint {
    lock
    waitse
    copyvar(VAR_0x8004, VAR_0x8000)
    bufferitemname(STR_VAR_2, VAR_0x8000)
    msgbox(Common_Text_MintAsk, MSGBOX_YESNO)
    goto_if_eq(VAR_RESULT, NO, Common_EventScript_MintLeave)
    checkitemspace(VAR_0x8000, 1)
    goto_if_eq(VAR_RESULT, TRUE, Common_EventScript_PickUpMint)
    goto(Common_EventScript_MintNoRoom)
    end
}

script Common_EventScript_MintLeave {
    msgbox(Common_Text_MintLeft)
    release
    end
}

script Common_EventScript_PickUpMint {
    additem(VAR_0x8004, 1)
    playfanfare(MUS_OBTAIN_ITEM)
    message(Common_Text_MintPicked)
    waitfanfare
    waitmessage
    removeobject(VAR_LAST_TALKED)
    msgbox(Common_Text_MintPutAway)
    release
    end
}

script Common_EventScript_MintNoRoom {
    msgbox(Common_Text_MintBagFull)
    release
    end
}

text Common_Text_MintAsk {
    "A fragrant mint plant is growing\n"
    "here!\p"
    "It's a {STR_VAR_2}!\n"
    "Would you like to pick it?"
}

text Common_Text_MintPicked {
    "{PLAYER} picked the {STR_VAR_2}!"
}

text Common_Text_MintLeft {
    "You left the mint plant alone."
}

text Common_Text_MintPutAway {
    "{PLAYER} put away the\n"
    "{STR_VAR_2} in the Bag."
}

text Common_Text_MintBagFull {
    "Too bad!\n"
    "The Bag is full."
}

// =============================================
// Individual mint scripts
// =============================================

// Route 1 - Lax Mint
script Route1_EventScript_Mint {
    setvar(VAR_0x8000, ITEM_LAX_MINT)
    goto(Common_EventScript_FindMint)
    end
}

