script Route23_EventScript_MissingBoulderBadgeTrigger {
    msgbox(Text_OnlySkilledTrainersAllowedThrough)
    playse(SE_BOO)
    msgbox(Text_CantLetYouPass)
    closemessage
    applymovement(LOCALID_PLAYER, Route23_Movement_WalkDown)
    applymovement(VAR_0x8009, Common_Movement_WalkInPlaceFasterDown)
    waitmovement(0)
    releaseall
    end
}

script Route23_EventScript_MissingBadgeTrigger {
    message(Text_OnlyPassWithBadgeDontHaveYet)
    waitmessage
    playse(SE_BOO)
    waitbuttonpress
    closemessage
    waitse
    applymovement(LOCALID_PLAYER, Route23_Movement_WalkDown)
    applymovement(VAR_0x8009, Common_Movement_WalkInPlaceFasterDown)
    waitmovement(0)
    releaseall
    end
}

