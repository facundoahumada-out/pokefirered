script EventScript_SailToVermilion2 {
    setvar(VAR_0x8006, SEAGALLOP_VERMILION_CITY)
    goto(EventScript_SailToDest)
    end
}

script EventScript_SailToOneIsland2 {
    setvar(VAR_0x8006, SEAGALLOP_ONE_ISLAND)
    goto(EventScript_SailToDest)
    end
}

