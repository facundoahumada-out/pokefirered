// Shared scripts for the daily gym leader rematches (see src/daily_battles.c)

// VAR_0x8008: TM given as reward. TMs are infinite, so it's only given if the player doesn't have it yet.
// Output: VAR_RESULT = FALSE if the bag was full (then the win doesn't count, so the player can battle again)
script EventScript_DailyLeaderReward {
    checkitem(VAR_0x8008)
    if (var(VAR_RESULT) == FALSE) {
        msgbox(Text_DailyLeaderTakeThis)
        giveitem(VAR_0x8008)
        if (var(VAR_RESULT) == FALSE) {
            return
        }
    }
    special(SetDailyLeaderBeatenToday)
    setvar(VAR_RESULT, TRUE)
    return
}

text Text_DailyLeaderDefeat {
    "What a battle!\n"
    "You really are the Champion!$"
}

text Text_DailyLeaderTakeThis {
    "That was a great battle!\n"
    "Please, take this as a reward.$"
}
