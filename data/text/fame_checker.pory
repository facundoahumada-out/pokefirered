text PokemonJournal_Text_SpecialFeatureBrock {
    "Pokémon Journal\p"
    "Special Feature: Pewter Gym\n"
    "Leader Brock!\p"
    "Brock rarely laughs, but is said to\n"
    "be unable to stop if he starts.$"
}

text PokemonJournal_Text_SpecialFeatureMisty {
    "Pokémon Journal\p"
    "Special Feature: Cerulean Gym\n"
    "Leader Misty!\p"
    "Misty is said to worship Lorelei\n"
    "of the Elite Four.$"
}

text PokemonJournal_Text_SpecialFeatureLtSurge {
    "Pokémon Journal\p"
    "Special Feature: Vermilion Gym\n"
    "Leader Lt. Surge!\p"
    "Lt. Surge is rumored to have been\n"
    "a pilot while home in America.\p"
    "He used the electricity generated\n"
    "by Pokémon to power his plane.$"
}

text PokemonJournal_Text_SpecialFeatureErika {
    "Pokémon Journal\p"
    "Special Feature: Celadon Gym\n"
    "Leader Erika!\p"
    "Rumor has it that if you peek into\n"
    "Celadon Gym, you can often\l"
    "see Erika snoozing.$"
}

text PokemonJournal_Text_SpecialFeatureKoga {
    "Pokémon Journal\p"
    "Special Feature: Fuchsia Gym\n"
    "Leader Koga!\p"
    "Koga is said to have a thorough\n"
    "knowledge of medicine.\p"
    "He even concocts medicine to nurse\n"
    "his Pokémon to health.$"
}

text PokemonJournal_Text_SpecialFeatureSabrina {
    "Pokémon Journal\p"
    "Special Feature: Saffron Gym\n"
    "Leader Sabrina!\p"
    "People say that Sabrina can\n"
    "communicate with her Pokémon\l"
    "during battle without speaking.$"
}

text PokemonJournal_Text_SpecialFeatureBlaine {
    "Pokémon Journal\p"
    "Special Feature: Cinnabar Gym\n"
    "Leader Blaine!\p"
    "Blaine is said to remove his dark\n"
    "shades only when he is thinking up\l"
    "new quiz questions.$"
}

text PokemonJournal_Text_SpecialFeatureLorelei {
    "Pokémon Journal\p"
    "Special Feature:\n"
    "Elite Four's Lorelei!\p"
    "Known for her logical, calculated,\n"
    "and cool battling style, Lorelei\l"
    "has a surprising secret!$"
}

text PokemonJournal_Text_SpecialFeatureBruno {
    "Pokémon Journal\p"
    "Special Feature:\n"
    "Elite Four's Bruno!\p"
    "Bruno apparently joined the Elite\n"
    "Four out of his burning ambition to\l"
    "battle the best Trainers.$"
}

text PokemonJournal_Text_SpecialFeatureAgatha {
    "Pokémon Journal\p"
    "Special Feature:\n"
    "Elite Four's Agatha!\p"
    "In her youth, Agatha and Prof.\n"
    "Oak were rivals who vied for\l"
    "supremacy as Trainers.$"
}

text PokemonJournal_Text_SpecialFeatureLance {
    "Pokémon Journal\p"
    "Special Feature:\n"
    "Elite Four's Lance!\p"
    "Lance's grandfather is thought to\n"
    "be the elder of a famous clan of\l"
    "dragon masters.$"
}

text PokemonJournal_Text_SpecialFeatureProfOak {
    "Pokémon Journal\p"
    "Special Feature: Prof. Oak,\n"
    "the Pokémon Researcher!\p"
    "Prof. Oak reportedly lives with his\n"
    "grandchildren Daisy and {RIVAL}.$"
}

text PokemonJournal_Text_SpecialFeatureDaisyOak {
    "This is a Pokémon Journal from\n"
    "years ago…\p"
    "Pokémon Journal\n"
    "Contest Special!\p"
    "The Spring Pokémon Contest's\n"
    "Grand Champion is Daisy Oak of\l"
    "Pallet Town!$"
}

text PokemonJournal_Text_SpecialFeatureMrFuji {
    "Pokémon Journal\p"
    "Special Feature:\n"
    "Mr. Fuji of Pokémon House!\p"
    "Editor: The shy Mr. Fuji turned\n"
    "down our interview requests.\p"
    "He is a kindly man who is adored\n"
    "and respected in Lavender Town.$"
}
