text Help_Text_HowToUsePokedex {
    "{CIRCLE_1} Select “Pokédex” on the Menu.\n"
    "{CIRCLE_2} Choose Pokémon using commands such\n"
    "   as “Pokémon List,”\n"
    "   “Habitats of Pokémon,” and\n"
    "   “Search.”\n"
    "{CIRCLE_3} Select a Pokémon to obtain detailed\n"
    "   information.$"
}

text Help_Text_HowToUsePokemon {
    "{CIRCLE_1} Select “Pokémon” on the Menu.\n"
    "{CIRCLE_2} Choose a Pokémon in your party.\n"
    "{CIRCLE_3} Select “Summary,” “Switch,”\n"
    "   or “Item.”$"
}

text Help_Text_HowToUseSummary {
    "{CIRCLE_1} Select “Summary.”\n"
    "{CIRCLE_2} Press left or right on the {PLUS} Control\n"
    "   Pad to check the information:\n"
    "   “Pokémon Info”\n"
    "   “Pokémon Skills”\n"
    "   “Known Moves”$"
}

text Help_Text_HowToUseSwitch {
    "{CIRCLE_1} Choose the Pokémon you want to\n"
    "   switch around.\n"
    "{CIRCLE_2} Select “Switch.”\n"
    "{CIRCLE_3} Select the Pokémon to switch with\n"
    "   the first one.\n"
    "The Pokémon at the left of the screen\n"
    "will be the first one out in a battle.$"
}

text Help_Text_HowToUseItem {
    "{CIRCLE_1} Select “Item.”\n"
    "{CIRCLE_2} Select whether you want to “Give”\n"
    "   an item to the Pokémon to hold,\n"
    "   or “Take” an item it is holding.\n"
    "A Pokémon can hold no more than one\n"
    "item!$"
}

text Help_Text_HowToUseBag {
    "{CIRCLE_1} Select “Bag” on the Menu.\n"
    "{CIRCLE_2} Press left or right on the {PLUS} Control\n"
    "   Pad to check the data headings:\n"
    "   “Items”\n"
    "   “Key Items”\n"
    "   “Poké Balls”\n"
    "   Press up or down to select an item.$"
}

text Help_Text_HowToUseAnItem {
    "{CIRCLE_1} Select the “Items” Pocket.\n"
    "{CIRCLE_2} Press up or down on the {PLUS} Control\n"
    "   Pad to select an item.\n"
    "{CIRCLE_3} Select “Use” to use the selected\n"
    "   item.\n"
    "Some items may not be used depending\n"
    "on the place and/or situation.$"
}

text Help_Text_HowToUseKeyItem {
    "{CIRCLE_1} Select the “Key Items” Pocket.\n"
    "{CIRCLE_2} Press up or down on the {PLUS} Control\n"
    "   Pad to select a key item.\n"
    "{CIRCLE_3} Select “Use” to use the selected\n"
    "   key item.$"
}

text Help_Text_HowToUsePokeBall {
    "{CIRCLE_1} While battling a wild Pokémon,\n"
    "   select the Bag's “Poké Balls”\n"
    "   Pocket.\n"
    "{CIRCLE_2} Press up or down on the {PLUS} Control\n"
    "   Pad to select a Poké Ball.\n"
    "{CIRCLE_3} Select “Use” to throw the selected\n"
    "   Poké Ball.$"
}

text Help_Text_HowToUsePlayer {
    "{CIRCLE_1} Select “{PLAYER}” on the Menu.\n"
    "{CIRCLE_2} Your Trainer Card is displayed face\n"
    "   up with basic information. Press the\n"
    "   A Button to turn the Card over.\n"
    "{CIRCLE_3} A variety of data can be found on\n"
    "   the reverse side of the Card.$"
}

text Help_Text_HowToUseSave {
    "{CIRCLE_1} Select “Save” on the Menu.\n"
    "{CIRCLE_2} Select “Yes” and your progress is\n"
    "   recorded in the save file.\n"
    "Once the game is saved, you may turn\n"
    "off the game. Your game can be resumed\n"
    "from where you saved.$"
}

text Help_Text_HowToUseOption {
    "{CIRCLE_1} Select “Option” on the Menu.\n"
    "{CIRCLE_2} Press up or down on the {PLUS} Control\n"
    "   Pad to select an optional item, then\n"
    "   press left or right to alter the\n"
    "   settings.\n"
    "{CIRCLE_3} Select “Cancel” or press the\n"
    "   B Button after making changes.$"
}

text Help_Text_HowToUsePotion {
    "{CIRCLE_1} Open the Menu.\n"
    "{CIRCLE_2} Press up or down on the {PLUS} Control\n"
    "   Pad and select “Bag.”\n"
    "{CIRCLE_3} Select “Potion” in the “Items”\n"
    "   Pocket.\n"
    "{CIRCLE_4} Select “Use.”\n"
    "{CIRCLE_5} Select the Pokémon to be healed.$"
}

text Help_Text_HowToUseTownMap {
    "{CIRCLE_1} Open the Menu.\n"
    "{CIRCLE_2} Press up or down on the {PLUS} Control\n"
    "   Pad and select “Bag.”\n"
    "{CIRCLE_3} Press left or right to open the\n"
    "   “Key Items” Pocket, then press\n"
    "   up or down to select “Town Map.” \n"
    "{CIRCLE_4} Select “Use” to open the Town Map.$"
}

text Help_Text_HowToUseTM {
    "{CIRCLE_1} Open the Menu.\n"
    "{CIRCLE_2} Open the “Key Items” Pocket in the\n"
    "   “Bag.”\n"
    "{CIRCLE_3} “Open” the TM Case.\n"
    "{CIRCLE_4} Select and “Use” a TM.\n"
    "{CIRCLE_5} Select a Pokémon that can learn the\n"
    "   move in the TM.$"
}

text Help_Text_HowToUseHM {
    "{CIRCLE_1} Open the Menu.\n"
    "{CIRCLE_2} Open the “Key Items” Pocket in the\n"
    "   “Bag.”\n"
    "{CIRCLE_3} “Open” the TM Case.\n"
    "{CIRCLE_4} Select and “Use” an HM.\n"
    "{CIRCLE_5} Select a Pokémon that can learn it.\n"
    "HMs are hard to remove, so be careful!$"
}

text Help_Text_HowToUseMoveOutsideOfBattle {
    "{CIRCLE_1} Open the Menu.\n"
    "{CIRCLE_2} Select “Pokémon.”\n"
    "{CIRCLE_3} Select a Pokémon that knows an\n"
    "   HM move. The usable HM move(s)\n"
    "   will be shown in blue. Select and\n"
    "   use the desired move to destroy an\n"
    "   obstacle, fly, surf, etc.$"
}

text Help_Text_HowToRideBicycle {
    "{CIRCLE_1} Open the Menu. Open the\n"
    "   “Key Items” Pocket in the “Bag”\n"
    "   and select the “Bicycle.”\n"
    "{CIRCLE_2} The Bicycle can be ridden by\n"
    "   selecting “Use.” You may also\n"
    "   “Register” it for instant use by\n"
    "   pressing Select.$"
}

text Help_Text_HowToEnterName {
    "{CIRCLE_1} Move the cursor to the letter you\n"
    "   want with the {PLUS} Control Pad, then\n"
    "   press the A Button to enter it.\n"
    "{CIRCLE_2} Press the B Button to back up.\n"
    "{CIRCLE_3} Press Select to switch between\n"
    "   uppercase and lowercase letters.\n"
    "{CIRCLE_4} Press the A Button on “OK.”$"
}

text Help_Text_HowToUsePC {
    "{CIRCLE_1} Go to any Pokémon Center, go up\n"
    "   to the PC, then press the A Button.$"
}

text Help_Text_HowToUseBillsPC {
    "{CIRCLE_1} Select “{STR_VAR_1}'S PC” on the PC.\n"
    "{CIRCLE_2} Select from one of the top three\n"
    "   Menu items to access the Pokémon\n"
    "   Storage System.\n"
    "If you catch a Pokémon when you have\n"
    "six in your party, the Pokémon is sent\n"
    "automatically to a Box in the System!$"
}

text Help_Text_HowToUseWithdraw {
    "{CIRCLE_1} Select a Pokémon in the open Box\n"
    "   with the {PLUS} Control Pad.\n"
    "{CIRCLE_2} Select “Withdraw” to remove the\n"
    "   Pokémon from the Box and add it to\n"
    "   your party.\n"
    "You may not withdraw a Pokémon if you\n"
    "already have six Pokémon with you!$"
}

text Help_Text_HowToUseDeposit {
    "{CIRCLE_1} Select a Pokémon in your party with\n"
    "   the {PLUS} Control Pad.\n"
    "{CIRCLE_2} Select “Deposit.”\n"
    "{CIRCLE_3} Select the Box, then press the\n"
    "   A Button to store the Pokémon.\n"
    "If you have only one Pokémon with you,\n"
    "it may not be stored!$"
}

text Help_Text_HowToUseMove {
    "{CIRCLE_1} Select a Pokémon in the open Box.\n"
    "{CIRCLE_2} Pick up the Pokémon by selecting\n"
    "   “Move” and move it anywhere with\n"
    "   the {PLUS} Control Pad.\n"
    "{CIRCLE_3} Move the Pokémon to the Box name\n"
    "   and press left or right to move it\n"
    "   to another Box.$"
}

text Help_Text_HowToMoveItems {
    "{CIRCLE_1} Faintly shown Pokémon can be made\n"
    "   to hold an item by selecting it and\n"
    "   pressing the A Button.\n"
    "{CIRCLE_2} Clearly shown Pokémon can be made\n"
    "   to give the item they are holding to\n"
    "   another Pokémon, or return the item\n"
    "   to the Bag with the A Button.$"
}

text Help_Text_HowToUsePlayersPC {
    "{CIRCLE_1} Select “{PLAYER}'s PC” on the PC.\n"
    "{CIRCLE_2} Select either “Item Storage” or\n"
    "   “Mailbox.”\n"
    "You may store things in your own PC\n"
    "if your Bag is full. You may also\n"
    "withdraw items stored in your PC.$"
}

text Help_Text_HowToUseWithdrawItem {
    "{CIRCLE_1} Select “Withdraw Item.”\n"
    "{CIRCLE_2} Select the item to be withdrawn.\n"
    "{CIRCLE_3} The item can be withdrawn and\n"
    "   placed in the Bag's Items Pocket.\n"
    "   It may also be directly given to a\n"
    "   Pokémon to hold.$"
}

text Help_Text_HowToUseDepositItem {
    "{CIRCLE_1} Select “Deposit Item.”\n"
    "{CIRCLE_2} Select the item in the Bag to be\n"
    "   deposited using the {PLUS} Control Pad.\n"
    "{CIRCLE_3} If there is more than one \n"
    "   item to be deposited, enter the\n"
    "   quantity with the {PLUS} Control Pad,\n"
    "   then press the A Button.$"
}

text Help_Text_HowToUseMailbox {
    "When Mail is taken from a Pokémon,\n"
    "it is moved to the Mailbox. If it has\n"
    "no Mail, the Mailbox can't be used.\n"
    "{CIRCLE_1} Select “{PLAYER}'S PC” on the PC.\n"
    "{CIRCLE_2} Select “Mailbox” to read Mail or\n"
    "   make a Pokémon hold Mail.$"
}

text Help_Text_HowToUseProfOaksPC {
    "{CIRCLE_1} Select “Prof. Oak's PC” on the PC.\n"
    "{CIRCLE_2} Prof. Oak will evaluate your\n"
    "   Pokédex.\n"
    "His evaluations should give you hints\n"
    "for catching more Pokémon!$"
}

text Help_Text_HowToOpenMenu {
    "{CIRCLE_1} Press Start.\n"
    "{CIRCLE_2} The Menu will open on the right.\n"
    "{CIRCLE_3} Depending on the situation, the Menu\n"
    "   may feature different headings.\n"
    "The Menu will not open in certain\n"
    "situations such as when talking, doing\n"
    "something, battling, etc.$"
}

text Help_Text_HowToUseFight {
    "{CIRCLE_1} Select “Fight.”\n"
    "{CIRCLE_2} Select one of the moves shown,\n"
    "and that move will be used!$"
}

text Help_Text_HowToUsePokemon2 {
    "{CIRCLE_1} Select “Pokémon.”\n"
    "{CIRCLE_2} Select the Pokémon in your party\n"
    "   that you want to use.\n"
    "{CIRCLE_3} If you have two or more Pokémon\n"
    "   with you, they may be switched by\n"
    "   selecting “Shift.” Check Pokémon\n"
    "   data by selecting “Summary.”$"
}

text Help_Text_HowToUseShift {
    "This command switches the Pokémon in\n"
    "battle with another one in your party.\n"
    "{CIRCLE_1} Select the Pokémon to be sent out.\n"
    "{CIRCLE_2} Select “Shift.”\n"
    "{CIRCLE_3} The selected Pokémon will switch\n"
    "   places with the Pokémon in battle!$"
}

text Help_Text_HowToUseSummary2 {
    "{CIRCLE_1} Select “Summary.”\n"
    "{CIRCLE_2} Press left or right on the {PLUS} Control\n"
    "   Pad to check the information:\n"
    "   “Pokémon Info”\n"
    "   “Pokémon Skills”\n"
    "   “Known Moves”$"
}

text Help_Text_HowToUseBag2 {
    "{CIRCLE_1} Select “Bag.”\n"
    "{CIRCLE_2} Press left or right on the {PLUS} Control\n"
    "   Pad to check the data headings:\n"
    "   “Items”\n"
    "   “Key Items”\n"
    "   “Poké Balls”\n"
    "   Press up or down to select an item.$"
}

raw `

Help_Text_HowToReadPokedex::
	.string "{CIRCLE_1} Pokémon that you have caught are\n"
	.string "   identified by a Poké Ball mark on\n"
	.string "   the Pokédex list.\n"
	.string "{CIRCLE_2} A caught Pokémon will provide a\n"
	.string "   large amount of data.\n"
	.if REVISION < 1
	.string "{CIRCLE_3} Select “Area” to display the Town\n"
	.string "   Map with the Pokémon's habitat(s).$"
	.else
	.string "{CIRCLE_3} Select “Next Data” to display the\n"
	.string "   Town Map with its habitat(s).$"
	.endif

Help_Text_HowToUseHomePC::
	.string "{CIRCLE_1} Go up to the PC at home, then press\n"
	.string "   the A Button.\n"
	.string "{CIRCLE_2} The PC will turn on.\n"
	.string "{CIRCLE_3} Select either “Item Storage” or\n"
	.string "   “Mailbox.”$"
`

text Help_Text_HowToUseItemStorage {
    "{CIRCLE_1} Select “Withdraw Item” to withdraw\n"
    "   an item stored on your PC.\n"
    "{CIRCLE_2} Select “Deposit Item” to put \n"
    "   an item from your Bag into your PC.$"
}

text Help_Text_HowToUseWithdrawItem2 {
    "{CIRCLE_1} Select “Withdraw Item.”\n"
    "{CIRCLE_2} Select the item to be withdrawn.\n"
    "{CIRCLE_3} The item can be withdrawn and\n"
    "   placed in the Bag's Items Pocket.\n"
    "   It may also be directly given to a\n"
    "   Pokémon to hold.$"
}

text Help_Text_HowToUseDepositItem2 {
    "{CIRCLE_1} Select “Deposit Item.”\n"
    "{CIRCLE_2} Select the item in the Bag to be\n"
    "   deposited using the {PLUS} Control Pad.\n"
    "{CIRCLE_3} If there is nothing in the Bag, this\n"
    "   command can't be used!$"
}

text Help_Text_HowToUseMailbox2 {
    "When Mail is taken from a Pokémon,\n"
    "it is moved to the Mailbox. If it has\n"
    "no Mail, the Mailbox can't be used.\n"
    "{CIRCLE_1} Select Mail by name to read it or\n"
    "   make a Pokémon hold it.$"
}

text Help_Text_HowToUseRun {
    "You may not “Run” from a Trainer\n"
    "battle!\n"
    "{CIRCLE_1} You may “Run” from a wild Pokémon.\n"
    "{CIRCLE_2} Your chance of escape is improved\n"
    "   if your Pokémon in battle is fast.$"
}

text Help_Text_HowToRegisterKeyItem {
    "You may “Register” a key item for\n"
    "instant use by pressing Select!\n"
    "{CIRCLE_1} Open the “Key Items” Pocket.\n"
    "{CIRCLE_2} Select the key item, then select\n"
    "   “Register.”$"
}

text Help_Text_HowToUseBall {
    "{CIRCLE_1} Select to throw the special Poké\n"
    "   Ball used only in the Safari Zone.\n"
    "When wild Pokémon appear, throw lots\n"
    "of Safari Balls to catch them!$"
}

text Help_Text_HowToUseBait {
    "{CIRCLE_1} Select to throw the special food\n"
    "   used only in the Safari Zone.\n"
    "It is Pokémon food rolled up into\n"
    "a ball for easy eating. When Bait is\n"
    "thrown, the wild Pokémon may get\n"
    "attracted by it, and may not flee!$"
}

text Help_Text_HowToUseRock {
    "{CIRCLE_1} Select to throw a rock lying on\n"
    "   the ground in the Safari Zone.\n"
    "Throwing a rock at a Pokémon may \n"
    "make it run away, but it becomes easier\n"
    "to catch!$"
}

text Help_Text_HowToUseHallOfFame {
    "{CIRCLE_1} Select “Hall of Fame” on the PC.\n"
    "{CIRCLE_2} The Pokémon that have entered the\n"
    "   Hall of Fame can be examined.$"
}

