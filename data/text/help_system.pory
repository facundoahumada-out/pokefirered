text Help_Text_HowToUseTypeMatchupList {
    "Depending on the matchup of the\n"
    "move type and the target Pokémon's\l"
    "type, the move's effectiveness varies:\l"
    "{CIRCLE_DOT}: Super effective!\l"
    "{TRIANGLE}: Not very effective\l"
    "{BIG_MULT_X}: Not effective at all\l"
    "(No changes for other matchups.)$"
}

text Help_Text_TypeMatchupOwnMoveDark {
    "Effect on the opposing Pokémon:\p"
    "   {CIRCLE_DOT}: Psychic, Ghost\p"
    "   {TRIANGLE}: Fighting, Dark, Steel$"
}

